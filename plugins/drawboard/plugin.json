{
  "id": "com.github.eNest.drawboard",
  "name": "画板",
  "version": "1.0.0",
  "description": "手绘风自由画板：压感钢笔、荧光笔、手绘图形与文字、贴图标注，滚轮缩放空格平移，多页草稿自动保存，一键复制与导出 PNG/JPG。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "设计",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.2.3"
  },
  "permissions": [
    "clipboard.writeImage"
  ],
  "window": {
    "width": 960,
    "height": 640,
    "minWidth": 480,
    "minHeight": 360
  },
  "features": [
    {
      "code": "main",
      "explain": "画板 / 手绘草图",
      "cmds": [
        "画板",
        "手绘",
        "白板",
        "涂鸦",
        "自由画板",
        "drawboard"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "画板",
      "手绘",
      "白板",
      "设计"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5211/"
  }
}
