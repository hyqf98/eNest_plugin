{
  "id": "com.github.eNest.middleware",
  "name": "中间件控制台",
  "version": "0.3.0",
  "description": "Kafka / RabbitMQ / MQTT / RocketMQ 统一控制台：连接管理、Topic 与队列、消息查询溯源与实时监听、消费组与监控",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.2.0"
  },
  "permissions": [
    "mw.connect",
    "mw.query",
    "mw.admin",
    "notify",
    "clipboard.write",
    "shell.openExternal",
    "backend.node"
  ],
  "contributes": {
    "settings": [
      {
        "id": "middleware.prefs",
        "title": "中间件",
        "items": [
          {
            "key": "workbench",
            "type": "page",
            "label": "打开中间件设置与快捷键",
            "entry": {
              "code": "settings"
            }
          },
          {
            "key": "followShellTheme",
            "type": "switch",
            "label": "跟随壳子主题",
            "default": true
          }
        ]
      }
    ]
  },
  "window": {
    "width": 720,
    "height": 440,
    "minWidth": 480,
    "minHeight": 260
  },
  "features": [
    {
      "code": "main",
      "explain": "消息中间件控制台",
      "cmds": [
        "中间件",
        "middleware",
        "kafka",
        "rabbitmq",
        "mqtt",
        "rocketmq",
        "消息队列"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": [
      "中间件",
      "Kafka",
      "RabbitMQ",
      "MQTT",
      "RocketMQ",
      "消息队列"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5191/"
  },
  "backend": {
    "entry": "backend/index.cjs"
  }
}
