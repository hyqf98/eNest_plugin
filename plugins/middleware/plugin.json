{
  "id": "com.github.eNest.middleware",
  "name": "中间件控制台",
  "version": "0.0.1",
  "description": "可安装驱动扩展的消息中间件控制台：连接、消息、消费组与监控",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "net.messaging",
    "net.messaging.read",
    "net.messaging.admin",
    "notify",
    "clipboard.write",
    "backend.node"
  ],
  "window": {
    "width": 720,
    "height": 440,
    "minWidth": 480,
    "minHeight": 260
  },
  "features": [
    {
      "code": "main",
      "title": "中间件控制台",
      "explain": "消息中间件控制台",
      "cmds": [
        "中间件",
        "middleware",
        "消息队列",
        "zjj",
        "mq"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": [
      "中间件",
      "消息队列"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5191/"
  },
  "backend": {
    "entry": "backend/index.cjs"
  }
}
