{
  "id": "com.enest.translate",
  "name": "翻译",
  "version": "1.2.1",
  "description": "多引擎翻译（Google/MyMemory 自动切换），自动检测语言，一键复制译文。",
  "author": "Lingua",
  "main": "index.html",
  "category": "效率",
  "icon": "icon.svg",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "net.fetch",
    "clipboard.read",
    "clipboard.write",
    "storage.local",
    "ui.setTitle",
    "ui.toast",
    "ui.resize"
  ],
  "window": {
    "minWidth": 420,
    "minHeight": 360
  },
  "features": [
    {
      "code": "main",
      "explain": "翻译文本",
      "cmds": [
        "翻译",
        "translate",
        "fy"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": [
      "翻译",
      "谷歌",
      "效率"
    ]
  }
}
