{
  "id": "com.github.eNest.translate",
  "name": "翻译",
  "version": "1.4.0",
  "description": "多引擎翻译、原文译文对照即时翻译（防抖）、语言快捷切换、历史与收藏、双语复制导出。",
  "author": "Lingua",
  "main": "index.html",
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "net.fetch",
    "clipboard.read",
    "clipboard.write"
  ],
  "window": {
    "minWidth": 420,
    "minHeight": 360
  },
  "features": [
    {
      "code": "main",
      "explain": "翻译文本",
      "cmds": [
        "翻译",
        "translate",
        "fy",
        {
          "type": "over",
          "label": "翻译文本",
          "minLength": 1,
          "maxLength": 10000
        }
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": [
      "翻译",
      "谷歌",
      "效率"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "contributes": {
    "settings": [
      {
        "id": "translate.preferences",
        "title": "翻译",
        "items": [
          {
            "key": "srcLang",
            "type": "select",
            "label": "默认源语言",
            "default": "auto",
            "options": [
              {
                "label": "自动检测",
                "value": "auto"
              },
              {
                "label": "中文",
                "value": "zh-CN"
              },
              {
                "label": "英语",
                "value": "en"
              },
              {
                "label": "日语",
                "value": "ja"
              },
              {
                "label": "韩语",
                "value": "ko"
              },
              {
                "label": "法语",
                "value": "fr"
              },
              {
                "label": "德语",
                "value": "de"
              },
              {
                "label": "西班牙语",
                "value": "es"
              },
              {
                "label": "俄语",
                "value": "ru"
              }
            ]
          },
          {
            "key": "tgtLang",
            "type": "select",
            "label": "默认目标语言",
            "default": "zh-CN",
            "options": [
              {
                "label": "中文",
                "value": "zh-CN"
              },
              {
                "label": "英语",
                "value": "en"
              },
              {
                "label": "日语",
                "value": "ja"
              },
              {
                "label": "韩语",
                "value": "ko"
              },
              {
                "label": "法语",
                "value": "fr"
              },
              {
                "label": "德语",
                "value": "de"
              },
              {
                "label": "西班牙语",
                "value": "es"
              },
              {
                "label": "俄语",
                "value": "ru"
              }
            ]
          },
          {
            "key": "engine",
            "type": "select",
            "label": "默认引擎",
            "default": "auto",
            "options": [
              {
                "label": "自动",
                "value": "auto"
              },
              {
                "label": "Google",
                "value": "google"
              },
              {
                "label": "MyMemory",
                "value": "mymemory"
              }
            ]
          },
          {
            "key": "autoTranslate",
            "type": "switch",
            "label": "暂停自动翻译（仅手动翻译）",
            "default": false
          },
          {
            "key": "resultFontSize",
            "type": "slider",
            "label": "桌面译文字号",
            "default": 18,
            "min": 14,
            "max": 24,
            "step": 1
          }
        ]
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5207/"
  }
}
