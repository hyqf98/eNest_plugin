{
  "id": "com.github.eNest.translate",
  "name": "翻译",
  "version": "0.0.1",
  "description": "多引擎翻译、原文译文对照即时翻译（防抖）、语言快捷切换、历史与收藏、双语复制导出。",
  "author": "Lingua",
  "main": "index.html",
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "net.fetch",
    "clipboard.read",
    "clipboard.write"
  ],
  "window": {
    "minWidth": 420,
    "minHeight": 360
  },
  "features": [
    {
      "code": "main",
      "explain": "翻译文本",
      "cmds": [
        "翻译",
        "translate",
        "fy",
        {
          "type": "over",
          "label": "翻译文本",
          "minLength": 1,
          "maxLength": 10000
        }
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": [
      "翻译",
      "谷歌",
      "效率"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5207/"
  }
}
