{
  "id": "com.github.eNest.dsh",
  "name": "DSH 驾驶舱",
  "version": "0.2.0",
  "description": "DeepSeek Harness 会话驾驶舱：小窗查看多会话进度并快速对话，大桌面嵌入完整 DSH Web UI；自带运行时（零本地依赖）与热更新、profile 管理、一键备份升级回退",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "dsh.connect",
    "dsh.chat",
    "dsh.admin",
    "shell.openExternal",
    "notify"
  ],
  "window": {
    "width": 720,
    "height": 560,
    "minWidth": 480,
    "minHeight": 420
  },
  "features": [
    {
      "code": "cockpit",
      "explain": "DSH 会话驾驶舱：进度查看 · 会话切换 · 快速对话",
      "cmds": [
        "dsh",
        "DSH",
        "deepseek",
        "harness",
        "驾驶舱",
        "会话进度",
        "deepseek harness"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque"
  },
  "market": {
    "featured": true,
    "tags": [
      "DeepSeek",
      "DSH",
      "Agent",
      "AI",
      "Harness"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5185/"
  }
}
