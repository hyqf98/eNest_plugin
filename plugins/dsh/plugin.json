{
  "id": "com.github.eNest.dsh",
  "name": "DSH 驾驶舱",
  "version": "0.0.1",
  "description": "DeepSeek Harness 会话驾驶舱与管理中心：完整 Web UI、快速对话、内核按需在线安装与多版本切换、Profile 环境配置与同步、进程启停和安全备份清理",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.2.1"
  },
  "permissions": [
    "backend.node",
    "shell.openExternal",
    "notify"
  ],
  "backend": {
    "entry": "backend/index.cjs"
  },
  "contributes": {
    "settings": [
      {
        "id": "dsh.manage",
        "title": "DSH 管理中心",
        "items": [
          {
            "key": "manage",
            "type": "page",
            "label": "内核、Profiles、备份与运行诊断",
            "entry": { "code": "manage" }
          }
        ]
      }
    ]
  },
  "window": {
    "width": 720,
    "height": 560,
    "minWidth": 480,
    "minHeight": 420
  },
  "features": [
    {
      "code": "cockpit",
      "explain": "DSH 会话驾驶舱：进度查看 · 会话切换 · 快速对话",
      "cmds": [
        "dsh",
        "DSH",
        "deepseek",
        "harness",
        "驾驶舱",
        "会话进度",
        "deepseek harness"
      ]
    },
    {
      "code": "manage",
      "explain": "DSH 管理中心：内核版本、Profiles、环境同步与维护",
      "cmds": [
        "dsh设置",
        "dsh管理",
        "dsh profiles",
        "dsh内核"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque"
  },
  "market": {
    "featured": true,
    "tags": [
      "DeepSeek",
      "DSH",
      "Agent",
      "AI",
      "Harness"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5185/"
  }
}
