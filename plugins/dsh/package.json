{
  "name": "dsh",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5185 --strictPort",
    "build": "node ../../scripts/build-plugin.mjs dsh",
    "pack": "node ../../scripts/pack-plugin.mjs dsh",
    "pack:runtime": "node scripts/pack-runtime.mjs",
    "prod": "node ../../scripts/build-plugin.mjs dsh",
    "typecheck:backend": "tsc -p backend/tsconfig.json",
    "test:backend:migration": "node --test backend/tests/backend-migration.test.mjs"
  },
  "dependencies": {
    "@enest/plugin-kit": "1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-slider": "^1.6.1",
    "js-yaml": "4.3.2",
    "undici": "^8.11.2",
    "socks": "^2.8.7"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  },
  "enestBackend": {
    "entry": "backend/index.ts",
    "dependencies": ["js-yaml", "undici", "socks"]
  },
  "enestBuild": {
    "entry": "scripts/build-hooks.mjs"
  }
}
