{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@db/*": ["src/js/*"] },
    "lib": ["ES2022", "DOM", "WebWorker"],
    "skipLibCheck": true
  },
  "include": ["src/js/sql-intelligence/**/*.js", "src/js/sql-intelligence/**/*.d.ts"]
}
