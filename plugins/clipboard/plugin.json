{
  "id": "com.github.eNest.clipboard",
  "name": "剪贴板",
  "version": "0.0.1",
  "description": "搜索文本、图片与文件历史；快捷回贴，文本变换工具条与暂存片段，批量整理。",
  "author": "eNest Labs",
  "main": "index.html",
  "views": {
    "layouts": ["quick", "shell", "panel"],
    "default": "shell",
    "panel": { "size": { "width": 300, "height": 240 } }
  },
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "clipboard.read",
    "clipboard.write",
    "clipboard.readImage",
    "clipboard.writeImage",
    "clipboard.history",
    "clipboard.paste"
  ],
  "background": {
    "entry": "assets/background.html",
    "events": [
      "clipboard.changed"
    ],
    "quickSearch": true
  },
  "window": {
    "minWidth": 420,
    "minHeight": 360
  },
  "features": [
    {
      "code": "main",
      "explain": "剪贴板历史",
      "cmds": [
        "剪贴板",
        "clipboard",
        "粘贴板"
      ]
    },
    {
      "code": "manage",
      "explain": "管理剪贴板历史",
      "cmds": [
        "剪贴板管理"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "transparent",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": [
      "剪贴板",
      "历史",
      "效率"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png",
      "assets/market/screenshots/02-images.webp",
      "assets/market/screenshots/03-files.webp"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5177/"
  }
}
