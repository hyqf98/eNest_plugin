{
  "name": "ssh",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5200 --strictPort",
    "build": "node ../../scripts/build-plugin.mjs com.github.eNest.ssh",
    "pack": "node ../../scripts/pack-plugin.mjs com.github.eNest.ssh",
    "prod": "node ../../scripts/build-plugin.mjs com.github.eNest.ssh"
  },
  "dependencies": {
    "@enest/plugin-kit": "0.0.1",
    "@enest/ssh-backend": "0.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  },
  "enestBackend": {
    "entry": "backend/index.ts",
    "dependencies": [
      "ssh2"
    ],
    "optionalExcluded": [
      "cpu-features",
      "nan"
    ],
    "packageFilesExcluded": {
      "ssh2": [
        "lib/protocol/crypto/build"
      ]
    }
  }
}
