{
  "id": "com.github.eNest.ssh",
  "name": "SSH管理",
  "version": "1.4.1",
  "description": "SSH 工作台：快速连接、终端提示、远程文件、三平台资源与进程端口、服务容器、传输和隧道",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.2.3"
  },
  "permissions": [
    "notify",
    "clipboard.write",
    "shell.openExternal",
    "ssh.agent",
    "backend.node"
  ],
  "contributes": {
    "settings": [
      {
        "id": "ssh.prefs",
        "title": "SSH",
        "items": [
          {
            "key": "followShellTheme",
            "type": "switch",
            "label": "跟随壳子主题",
            "default": true,
            "shareWithThemes": true
          },
          {
            "key": "workbenchSettings",
            "type": "page",
            "label": "SSH 详细设置与快捷键",
            "entry": {
              "code": "settings"
            }
          }
        ]
      }
    ]
  },
  "window": {
    "width": 720,
    "height": 420,
    "minWidth": 480,
    "minHeight": 240
  },
  "features": [
    {
      "code": "main",
      "explain": "SSH 管理与远程终端",
      "cmds": [
        "ssh",
        "终端",
        "服务器",
        "SSH管理",
        "ssh manager"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": [
      "SSH",
      "终端",
      "运维",
      "开发",
      "SFTP"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png",
      "assets/market/screenshots/02-remote-files.webp"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5200/"
  },
  "backend": {
    "entry": "backend/index.cjs"
  }
}
