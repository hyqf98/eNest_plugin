  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "icon.svg",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "clipboard.read",
    "clipboard.write",
    "ui.setTitle",
