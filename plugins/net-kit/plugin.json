{
  "id": "com.github.eNest.net-kit",
  "name": "网络调试台",
  "version": "1.1.0",
  "description": "HTTP / TCP / WebSocket 调试工作台：流式响应与 SSE、十六进制字节流、编解码策略、断言、curl 导入导出、集合与历史",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "net.fetch",
    "net.socket",
    "clipboard.write",
    "shell.openExternal"
  ],
  "net": {
    "allowInsecure": true
  },
  "window": {
    "width": 760,
    "height": 400,
    "minWidth": 480,
    "minHeight": 240
  },
  "features": [
    {
      "code": "main",
      "explain": "网络调试台：HTTP / TCP / WebSocket",
      "cmds": [
        "接口",
        "http",
        "tcp"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "HTTP",
      "TCP",
      "WebSocket",
      "curl",
      "SSE",
      "调试"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5192/"
  }
}
