{
  "id": "com.github.eNest.markdown",
  "name": "Markdown 编辑器",
  "version": "0.0.1",
  "description": "Typora 式所见即所得 Markdown 编辑器：即时渲染、Typora 主题、手绘风 Mermaid、图床上传（PicList/GitHub/自定义脚本）与本地文件工作台。",
  "author": "eNest Labs",
  "main": "index.html",
  "views": {
    "layouts": ["quick", "shell", "panel"],
    "default": "shell",
    "panel": { "size": { "width": 320, "height": 260 } }
  },
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "backend.node",
    "clipboard.readImage",
    "clipboard.write",
    "shell.openExternal"
  ],
  "backend": {
    "entry": "backend/index.cjs"
  },
  "window": {
    "minWidth": 480,
    "minHeight": 340
  },
  "features": [
    {
      "code": "main",
      "explain": "打开 Markdown 编辑器",
      "cmds": [
        "笔记",
        "md",
        "bj"
      ]
    },
    {
      "code": "inbox",
      "explain": "速记到收件箱",
      "cmds": [
        "速记",
        "inbox"
      ]
    },
    {
      "code": "settings",
      "explain": "Markdown 编辑器设置",
      "cmds": [
        "md设置",
        "markdown设置"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "transparent",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "Markdown",
      "编辑器",
      "Typora",
      "效率"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "contributes": {
    "openWith": [
      {
        "id": "markdown-files",
        "extensions": [
          "md",
          "markdown"
        ],
        "mimeTypes": [
          "text/markdown"
        ],
        "schemes": [
          "enest-md"
        ],
        "role": "Editor"
      }
    ],
    "homeCards": [
      {
        "id": "markdown-card",
        "title": "Markdown 编辑器",
        "glyph": "M",
        "color": "#5b9dd9",
        "explain": "所见即所得编辑、Typora 主题、图床上传",
        "openCode": "main"
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5190/"
  }
}
