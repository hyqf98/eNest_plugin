{
  "id": "com.github.eNest.markdown",
  "name": "Markdown 编辑器",
  "version": "0.0.1",
  "description": "Typora 式所见即所得 Markdown 编辑器：即时渲染、Typora 主题、手绘风 Mermaid、图床上传（PicList/GitHub/自定义脚本）与本地文件工作台。",
  "author": "eNest Labs",
  "main": "index.html",
  "views": {
    "layouts": ["quick", "shell", "panel"],
    "default": "shell",
    "panel": { "size": { "width": 320, "height": 260 } }
  },
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "backend.node",
    "clipboard.readImage",
    "clipboard.write",
    "shell.openExternal"
  ],
  "backend": {
    "entry": "backend/index.cjs"
  },
  "window": {
    "minWidth": 480,
    "minHeight": 340
  },
  "features": [
    {
      "code": "main",
      "explain": "打开 Markdown 编辑器",
      "cmds": [
        "笔记",
        "md",
        "bj"
      ]
    },
    {
      "code": "inbox",
      "explain": "速记到收件箱",
      "cmds": [
        "速记",
        "inbox"
      ]
    },
    {
      "code": "settings",
      "explain": "Markdown 编辑器设置",
      "cmds": [
        "md设置",
        "markdown设置"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "transparent",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "Markdown",
      "编辑器",
      "Typora",
      "效率"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "contributes": {
    "openWith": [
      {
        "id": "markdown-files",
        "extensions": [
          "md",
          "markdown"
        ],
        "mimeTypes": [
          "text/markdown"
        ],
        "schemes": [
          "enest-md"
        ],
        "role": "Editor"
      }
    ],
    "homeCards": [
      {
        "id": "markdown-card",
        "title": "Markdown 编辑器",
        "glyph": "M",
        "color": "#5b9dd9",
        "explain": "所见即所得编辑、Typora 主题、图床上传",
        "openCode": "main"
      }
    ],
    "settings": [
      {
        "id": "markdown.preferences",
        "title": "Markdown 编辑器",
        "items": [
          {
            "key": "followShellTheme",
            "type": "switch",
            "label": "跟随壳子主题",
            "default": true,
            "shareWithThemes": true
          },
          {
            "key": "typewriterMode",
            "type": "switch",
            "label": "打字机模式（当前行居中）",
            "default": false,
            "shareWithThemes": true
          },
          {
            "key": "focusMode",
            "type": "switch",
            "label": "专注模式（淡出非当前段落）",
            "default": false,
            "shareWithThemes": true
          },
          {
            "key": "renderHtml",
            "type": "switch",
            "label": "渲染内嵌 HTML（消毒后生效）",
            "default": true
          },
          {
            "key": "mermaidLook",
            "type": "select",
            "label": "Mermaid 图形风格",
            "default": "handDrawn",
            "options": [
              {
                "value": "handDrawn",
                "label": "手绘（Excalidraw 风）"
              },
              {
                "value": "rounded",
                "label": "圆润"
              },
              {
                "value": "classic",
                "label": "经典"
              }
            ],
            "shareWithThemes": true
          },
          {
            "key": "imageDefaultAction",
            "type": "select",
            "label": "粘贴图片默认动作",
            "default": "ask",
            "options": [
              {
                "value": "ask",
                "label": "每次询问"
              },
              {
                "value": "upload",
                "label": "上传到当前图床"
              },
              {
                "value": "local",
                "label": "存本地 assets 目录"
              },
              {
                "value": "base64",
                "label": "转 base64 内联"
              }
            ]
          },
          {
            "key": "localImageDir",
            "type": "text",
            "label": "本地图片目录",
            "default": ""
          },
          {
            "key": "autoSave",
            "type": "switch",
            "label": "自动保存（500ms 防抖）",
            "default": true
          },
          {
            "key": "codeTheme",
            "type": "select",
            "label": "代码块配色",
            "default": "default",
            "options": [
              {
                "value": "default",
                "label": "默认（跟随主题）"
              },
              {
                "value": "github",
                "label": "GitHub"
              },
              {
                "value": "monokai",
                "label": "Monokai"
              },
              {
                "value": "dracula",
                "label": "Dracula"
              },
              {
                "value": "solarized",
                "label": "Solarized Light"
              },
              {
                "value": "nord",
                "label": "Nord"
              }
            ]
          },
          {
            "key": "motionEnabled",
            "type": "switch",
            "label": "开启动效（箭头流光 / 呼吸灯）",
            "default": false
          },
          {
            "key": "motionPreset",
            "type": "select",
            "label": "动效预设",
            "default": "both",
            "options": [
              {
                "value": "both",
                "label": "全开（流光 + 呼吸）"
              },
              {
                "value": "flow",
                "label": "只做流光"
              },
              {
                "value": "breathe",
                "label": "只做呼吸灯"
              },
              {
                "value": "subtle",
                "label": "轻微"
              }
            ]
          },
          {
            "key": "motionMermaid",
            "type": "switch",
            "label": "Mermaid 箭头流光",
            "default": true
          },
          {
            "key": "motionTable",
            "type": "switch",
            "label": "表格动效",
            "default": true
          },
          {
            "key": "motionHighlight",
            "type": "switch",
            "label": "高亮文字呼吸灯",
            "default": true
          },
          {
            "key": "motionCode",
            "type": "switch",
            "label": "代码块边框流光",
            "default": true
          },
          {
            "key": "imageMaxWidth",
            "type": "number",
            "label": "图片最大宽度（%，0 = 不限）",
            "default": 100
          },
          {
            "key": "imageMaxHeight",
            "type": "number",
            "label": "图片最大高度（px，0 = 不限）",
            "default": 0
          },
          {
            "key": "htmlBlockMaxWidth",
            "type": "number",
            "label": "HTML 块最大宽度（%，0 = 不限）",
            "default": 100
          },
          {
            "key": "htmlBlockMaxHeight",
            "type": "number",
            "label": "HTML 块最大高度（px，0 = 不限）",
            "default": 0
          },
          {
            "key": "settingsPage",
            "type": "page",
            "label": "图床、主题与高级设置",
            "entry": {
              "code": "settings"
            }
          }
        ]
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5190/"
  }
}
