{
  "id": "com.enest.theme-demo",
  "name": "主题示例",
  "version": "0.1.0",
  "description": "主题包注册示例：manifest 声明「暖沙 / 靛蓝」双模式主题包，运行时注册「墨绿」，到设置→外观→主题下拉验证切换。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "设计",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [],
  "features": [
    {
      "code": "main",
      "explain": "主题包注册示例",
      "cmds": [
        "主题",
        "theme",
        "主题示例"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "contributes": {
    "themePacks": [
      {
        "id": "theme-demo.warm-sand",
        "name": "暖沙",
        "mode": "light",
        "tokens": {
          "--bg": "#f6efe4",
          "--surface": "#fffaf0",
          "--surface-2": "#f0e6d4",
          "--surface-3": "#e5d8c0",
          "--border": "rgba(90,72,48,0.10)",
          "--border-strong": "rgba(90,72,48,0.20)",
          "--text": "#4a3f30",
          "--text-2": "#7d7160",
          "--text-3": "#9a8f7e",
          "--accent": "#b0763c",
          "--ok": "#5f8f5a",
          "--danger": "#b5544a",
          "--link": "#b0763c"
        }
      },
      {
        "id": "theme-demo.indigo",
        "name": "靛蓝",
        "mode": "dark",
        "tokens": {
          "--bg": "#14172b",
          "--surface": "#1c2038",
          "--surface-2": "#252a45",
          "--surface-3": "#303657",
          "--border": "rgba(226,230,255,0.09)",
          "--border-strong": "rgba(226,230,255,0.16)",
          "--text": "#e8ebfa",
          "--text-2": "#a7adc9",
          "--text-3": "#7d84a3",
          "--accent": "#7c9aff",
          "--ok": "#6fbf9f",
          "--danger": "#e08d85",
          "--link": "#7c9aff"
        }
      }
    ]
  },
  "market": {
    "tags": [
      "主题",
      "示例",
      "设计"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5173/"
  }
}
