{
  "id": "com.github.eNest.screen-assistant",
  "name": "屏幕助手",
  "version": "0.0.1",
  "description": "截图与原图历史、裁剪箭头文字马赛克标注（含工具快捷键）、区域录屏和贴图管理；粘性半透明工具头，小窗快速操作，桌面展开完整编辑。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "媒体",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "screen.capture",
    "screen.record",
    "pin.create",
    "clipboard.readImage",
    "clipboard.writeImage",
    "clipboard.write",
    "shell.openExternal"
  ],
  "window": {
    "minWidth": 480,
    "minHeight": 360
  },
  "features": [
    {
      "code": "capture",
      "explain": "矩形截图",
      "cmds": [
        "截图",
        "screenshot",
        "截屏"
      ]
    },
    {
      "code": "record",
      "explain": "矩形录屏",
      "cmds": [
        "录屏",
        "record"
      ]
    },
    {
      "code": "pin",
      "explain": "贴图",
      "cmds": [
        "贴图",
        "pin"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": [
      "截图",
      "录屏",
      "贴图"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png",
      "assets/market/screenshots/02-annotation.webp"
    ]
  },
  "contributes": {
    "settings": [
      {
        "id": "screen-preferences",
        "title": "截图与录屏",
        "items": [
          {
            "key": "captureAction",
            "type": "select",
            "label": "截图完成后的操作",
            "default": "preview",
            "options": [
              {
                "label": "打开预览",
                "value": "preview"
              },
              {
                "label": "复制到剪贴板",
                "value": "copy"
              },
              {
                "label": "贴到屏幕",
                "value": "pin"
              }
            ]
          },
          {
            "key": "historyLimit",
            "type": "slider",
            "label": "原图历史保留数量",
            "default": 24,
            "min": 8,
            "max": 80,
            "step": 8
          },
          {
            "key": "withAudio",
            "type": "boolean",
            "label": "录屏默认录入系统声音",
            "default": false
          }
        ]
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5198/"
  }
}
