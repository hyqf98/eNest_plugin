{
  "id": "com.github.eNest.screen-assistant",
  "name": "屏幕助手",
  "version": "0.1.0",
  "description": "截图、长截图、区域/全屏录屏与统一媒体库，内置标注、GIF 导出、贴图和图片工具箱。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "媒体",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "screen.capture",
    "screen.record",
    "pin.create",
    "clipboard.readImage",
    "clipboard.writeImage",
    "clipboard.write"
  ],
  "window": {
    "width": 1020,
    "height": 700,
    "minWidth": 720,
    "minHeight": 460
  },
  "features": [
    {
      "code": "capture",
      "explain": "矩形区域截图",
      "cmds": ["截图", "截屏", "screenshot", "jt", "截图标注"]
    },
    {
      "code": "full",
      "explain": "全屏截图",
      "cmds": ["全屏截图", "fullscreen", "quanpingjietu"]
    },
    {
      "code": "longshot",
      "explain": "滚动长截图",
      "cmds": ["长截图", "滚动截图", "长截屏", "changjietu"]
    },
    {
      "code": "record",
      "explain": "矩形区域录屏",
      "cmds": ["录屏", "区域录屏", "record", "lp", "luping"]
    },
    {
      "code": "record-full",
      "explain": "全屏录屏",
      "cmds": ["全屏录屏", "quanpingluping"]
    },
    {
      "code": "pin",
      "explain": "贴图到桌面",
      "cmds": ["贴图", "pin", "tt", "tietu"]
    },
    {
      "code": "tools",
      "explain": "图片压缩、转换与处理",
      "cmds": [
        "图片",
        "压缩",
        "转换",
        "图片工具",
        "image",
        "tp",
        "tupian",
        "yasuo",
        { "type": "img", "label": "压缩这张图片" }
      ]
    },
    {
      "code": "library",
      "explain": "截图与录屏历史",
      "cmds": ["历史", "媒体库", "截图历史", "录制历史", "相册"]
    }
  ],
  "contributes": {
    "openWith": [
      {
        "id": "image-files",
        "extensions": ["png", "jpg", "jpeg", "webp", "gif"],
        "mimeTypes": ["image/png", "image/jpeg", "image/webp", "image/gif"],
        "role": "Viewer"
      }
    ]
  },
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": ["截图", "长截图", "录屏", "GIF", "贴图", "图片工具"],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png",
      "assets/market/screenshots/02-library.png",
      "assets/market/screenshots/03-tools.png",
      "assets/market/screenshots/04-editor.png",
      "assets/market/screenshots/05-video.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5198/"
  }
}
