{
  "id": "com.enest.hash",
  "name": "哈希与加密",
  "version": "1.0.0",
  "description": "多算法同屏哈希（SHA 家族/MD5）、HMAC、AES-GCM 与 RSA 加解密签名、JWT 解码、hex/base64 输出。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "clipboard.write",
    "clipboard.read"
  ],
  "window": {
    "width": 880,
    "height": 580,
    "minWidth": 420,
    "minHeight": 360
  },
  "features": [
    {
      "code": "main",
      "explain": "哈希 / 加解密 / JWT 解码",
      "cmds": [
        "哈希",
        "hash",
        "加密",
        "jm"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "哈希",
      "加密",
      "开发"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5173/"
  }
}
