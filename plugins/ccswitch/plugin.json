{
  "id": "com.github.eNest.ccswitch",
  "name": "供应商切换",
  "version": "0.0.1",
  "description": "AI CLI 供应商切换台：10 应用配置管理、50+ 预设、切换历史与回退、全量备份、MCP 同步、会话浏览与用量统计（复刻 cc-switch）",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.2.2"
  },
  "permissions": [
    "net.fetch",
    "hotkey",
    "notify",
    "clipboard.write",
    "shell.openExternal",
    "contribute",
    "backend.node"
  ],
  "contributes": {
    "homeCards": [
      {
        "id": "ccswitch-card",
        "title": "供应商切换",
        "glyph": "⇄",
        "color": "#e8a33d",
        "explain": "Claude Code / Codex / Gemini 等 10 应用供应商、切换历史、MCP、会话与用量",
        "openCode": "main"
      }
    ],
    "settings": [
      {
        "id": "ccswitch.prefs",
        "title": "供应商切换",
        "items": [
          {
            "key": "defaultApp",
            "type": "select",
            "label": "默认应用",
            "default": "claude-code",
            "options": [
              {
                "label": "Claude Code",
                "value": "claude-code"
              },
              {
                "label": "Codex CLI",
                "value": "codex"
              },
              {
                "label": "Gemini CLI",
                "value": "gemini-cli"
              }
            ]
          },
          {
            "key": "diffConfirm",
            "type": "switch",
            "label": "切换前显示 diff 确认",
            "default": true
          },
          {
            "key": "backupKeep",
            "type": "text",
            "label": "备份保留策略",
            "default": "插件后端自动快照，每应用保留最近 20 份"
          },
          {
            "key": "openPrefs",
            "type": "page",
            "label": "打开切换台设置",
            "entry": {
              "code": "settings"
            }
          }
        ]
      }
    ]
  },
  "window": {
    "width": 960,
    "height": 620,
    "minWidth": 520,
    "minHeight": 360
  },
  "features": [
    {
      "code": "main",
      "explain": "AI CLI 供应商切换台",
      "cmds": [
        "切换",
        "ccswitch",
        "gysd",
        "cc",
        "sq",
        "供应商"
      ]
    },
    {
      "code": "history",
      "explain": "切换历史与一键回退",
      "cmds": [
        "切换/历史",
        "回退"
      ]
    },
    {
      "code": "mcp",
      "explain": "MCP 服务器管理",
      "cmds": [
        "mcp",
        "切换/mcp"
      ]
    },
    {
      "code": "sessions",
      "explain": "AI 会话浏览与用量",
      "cmds": [
        "会话",
        "切换/会话"
      ]
    },
    {
      "code": "settings",
      "explain": "切换台设置",
      "cmds": [
        "切换/设置"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": false,
    "tags": [
      "AI",
      "供应商",
      "MCP",
      "Claude",
      "Codex",
      "开发"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5176/"
  },
  "backend": {
    "entry": "backend/index.cjs"
  }
}
