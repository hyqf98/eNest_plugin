{
  "id": "com.github.eNest.ccswitch",
  "name": "供应商切换",
  "version": "0.0.1",
  "description": "AI CLI 供应商切换台：10 应用配置管理、50+ 预设、切换历史与回退、全量备份、MCP 同步、会话浏览与用量统计（复刻 cc-switch）",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "net.fetch",
    "hotkey",
    "notify",
    "clipboard.write",
    "contribute",
    "backend.node"
  ],
  "contributes": {
    "homeCards": [
      {
        "id": "ccswitch-card",
        "title": "供应商切换",
        "glyph": "⇄",
        "color": "#e8a33d",
        "explain": "Claude Code / Codex / Gemini 等 10 应用供应商、切换历史、MCP、会话与用量",
        "openCode": "main"
      }
    ]
  },
  "window": {
    "width": 960,
    "height": 620,
    "minWidth": 520,
    "minHeight": 360
  },
  "features": [
    {
      "code": "main",
      "title": "供应商切换",
      "explain": "AI CLI 供应商切换台",
      "cmds": [
        "切换",
        "ccswitch",
        "gysd",
        "cc",
        "sq",
        "供应商",
        "cc切换",
        "switch provider"
      ]
    },
    {
      "code": "history",
      "title": "切换历史",
      "explain": "切换历史与一键回退",
      "cmds": [
        "切换/历史",
        "回退",
        "ht",
        "switch history"
      ]
    },
    {
      "code": "mcp",
      "title": "MCP 服务器管理",
      "explain": "MCP 服务器管理",
      "cmds": [
        "mcp",
        "切换/mcp",
        "mcp servers"
      ]
    },
    {
      "code": "sessions",
      "title": "AI 会话",
      "explain": "AI 会话浏览与用量",
      "cmds": [
        "会话",
        "切换/会话",
        "hh",
        "ai sessions"
      ]
    },
    {
      "code": "settings",
      "title": "供应商切换设置",
      "explain": "切换台设置",
      "cmds": [
        "切换/设置",
        "ccswitch settings"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": false,
    "tags": [
      "AI",
      "供应商",
      "MCP",
      "Claude",
      "Codex",
      "开发"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5176/"
  },
  "backend": {
    "entry": "backend/index.cjs"
  }
}
