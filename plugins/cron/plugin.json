{
  "id": "com.github.eNest.cron",
  "name": "Cron 工具",
  "version": "0.0.1",
  "description": "五/六域可视化构建、中文人性化描述、未来执行预览、预设库与 crontab 导出。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "clipboard.write"
  ],
  "window": {
    "width": 860,
    "height": 560,
    "minWidth": 420,
    "minHeight": 360
  },
  "features": [
    {
      "code": "main",
      "explain": "Cron 表达式构建与解析",
      "cmds": [
        "定时",
        "cron",
        "bs",
        "crontab",
        "定时任务"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "cron",
      "定时",
      "开发"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5182/"
  }
}
