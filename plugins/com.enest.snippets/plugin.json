{
  "id": "com.enest.snippets",
  "name": "代码片段",
  "version": "1.0.0",
  "description": "代码片段库：语法标签着色、占位符模板、Quick 即搜即复制、导入导出与使用排序。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "clipboard.write",
    "hotkey",
    "fs.read",
    "fs.write",
    "contribute"
  ],
  "window": {
    "minWidth": 460,
    "minHeight": 320
  },
  "features": [
    {
      "code": "main",
      "explain": "打开代码片段库",
      "cmds": [
        "片段",
        "snippet",
        "dp"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "代码",
      "片段",
      "开发"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "contributes": {
    "homeCards": [
      {
        "id": "snippets-card",
        "title": "代码片段",
        "glyph": "{}",
        "color": "#7c9cf5",
        "explain": "常用代码即搜即复制，占位符模板填值",
        "openCode": "main"
      }
    ],
    "settings": [
      {
        "id": "snippets.preferences",
        "title": "代码片段",
        "items": [
          {
            "key": "followShellTheme",
            "type": "switch",
            "label": "跟随壳子主题",
            "default": true
          }
        ]
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5173/"
  }
}
