{
  "name": "wallpaper-wall",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5223 --strictPort",
    "build": "node ../../scripts/build-plugin.mjs com.github.eNest.wallpaper-wall",
    "pack": "node ../../scripts/pack-plugin.mjs com.github.eNest.wallpaper-wall",
    "prod": "node ../../scripts/build-plugin.mjs com.github.eNest.wallpaper-wall",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p backend/tsconfig.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck:backend": "tsc -p backend/tsconfig.json",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "dependencies": {
    "@enest/plugin-kit": "0.0.1",
    "@jimp/custom": "^0.22.12",
    "@jimp/plugin-resize": "^0.22.12",
    "@jimp/types": "^0.22.12",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.13.0",
    "linkedom": "^0.18.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@enest/plugin-sdk": "0.0.1",
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "enestBackend": {
    "entry": "backend/index.ts",
    "dependencies": ["undici", "linkedom", "@jimp/custom", "@jimp/plugin-resize", "@jimp/types"],
    "packageFilesExcluded": { "undici": ["docs"] }
  },
  "enestBuild": {
    "entry": "scripts/build-hooks.mjs"
  }
}
