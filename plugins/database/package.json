{
  "name": "database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5183 --strictPort",
    "build": "node ../../scripts/build-plugin.mjs com.github.eNest.database",
    "pack": "node ../../scripts/pack-plugin.mjs com.github.eNest.database",
    "parser:generate": "node scripts/generate-execution-parser.mjs",
    "parser:check": "node scripts/generate-execution-parser.mjs --check",
    "typecheck:backend": "tsc -p backend/tsconfig.json",
    "test:backend": "node --test tests/backend/*.test.mjs",
    "test:backend:integration": "tsx --tsconfig backend/tsconfig.json --test tests/backend/*.test.ts",
    "prod": "node ../../scripts/build-plugin.mjs com.github.eNest.database"
  },
  "dependencies": {
    "@a2ui/agent": "^0.1.0",
    "@a2ui/markdown-it": "^0.2.2",
    "@a2ui/react": "^0.15.0",
    "@a2ui/web_core": "^0.15.0",
    "@clickhouse/client": "^1.24.1",
    "@duckdb/node-api": "^1.5.6-r.1",
    "@enest/lxgw-font": "0.0.1",
    "@enest/plugin-kit": "0.0.1",
    "@tdengine/websocket": "^3.5.0",
    "cassandra-driver": "^4.10.0",
    "csv-parse": "^7.0.3",
    "echarts": "^5.6.0",
    "lossless-json": "^4.3.1",
    "mermaid": "^11.6.0",
    "mongodb": "^7.7.0",
    "mssql": "^12.7.4",
    "mysql2": "^3.24.4",
    "neo4j-driver": "^6.2.0",
    "oracledb": "^26.0.0",
    "pg": "^8.23.0",
    "pg-query-stream": "^4.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.3.0",
    "sql-formatter": "^15.9.0",
    "undici": "^8.11.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.3",
    "@types/oracledb": "^7.0.3",
    "@types/pg": "^8.23.1",
    "@types/pg-query-stream": "^1.0.3",
    "esbuild": "^0.21.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "enestBackend": {
    "entry": "backend/index.ts",
    "dependencies": [
      "@clickhouse/client",
      "@duckdb/node-api",
      "@tdengine/websocket",
      "cassandra-driver",
      "csv-parse",
      "lossless-json",
      "mongodb",
      "mssql",
      "mysql2",
      "neo4j-driver",
      "oracledb",
      "pg",
      "pg-query-stream",
      "redis",
      "undici"
    ],
    "platformPackages": [
      "@duckdb/node-bindings-darwin-arm64",
      "@duckdb/node-bindings-darwin-x64",
      "@duckdb/node-bindings-win32-x64",
      "@duckdb/node-bindings-linux-x64"
    ],
    "packageFilesExcluded": {
      "neo4j-driver": [
        "lib/browser"
      ],
      "csv-parse": [
        "dist/iife",
        "dist/umd"
      ],
      "undici": [
        "docs"
      ],
      "@clickhouse/client": [
        "skills"
      ],
      "moment": [
        "min",
        "src",
        "dist"
      ],
      "js-md4": [
        "doc"
      ],
      "rxjs": [
        "src",
        "dist/bundles"
      ],
      "@redis/client": [
        "dist/esm"
      ],
      "@azure/msal-node": [
        "src"
      ],
      "oracledb": [
        "build/Release/oracledb-26.0.0-linux-arm64.node",
        "build/Release/oracledb-26.0.0-linux-arm64.node-buildinfo.txt"
      ],
      "@js-joda/core": [
        "src",
        "typings"
      ],
      "cassandra-driver": [
        "proposals",
        "Jenkinsfile"
      ]
    },
    "runtimeExcluded": [
      "typescript",
      "moment-timezone",
      "@azure/msal-browser"
    ]
  }
}
