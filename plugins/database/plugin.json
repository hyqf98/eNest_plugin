{
  "id": "com.github.eNest.database",
  "name": "数据库",
  "version": "1.4.1",
  "description": "多数据库工作台：离线编辑器、查询与结果编辑、结构关系、资源中心和只读数据比较",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.2.3"
  },
  "permissions": [
    "db.connect",
    "db.query",
    "db.schema",
    "notify",
    "clipboard.write",
    "shell.openExternal",
    "backend.node"
  ],
  "contributes": {
    "openWith": [
      {
        "id": "sqlite-files",
        "extensions": [
          "db",
          "sqlite"
        ],
        "mimeTypes": [
          "application/vnd.sqlite3"
        ],
        "schemes": [
          "enest-db"
        ],
        "role": "Viewer"
      }
    ],
    "settings": [
      {
        "id": "database.prefs",
        "title": "数据库",
        "items": [
          {
            "key": "workbench",
            "type": "page",
            "label": "打开数据库设置与快捷键",
            "entry": {
              "code": "settings"
            }
          },
          {
            "key": "followShellTheme",
            "type": "switch",
            "label": "跟随壳子主题",
            "default": true,
            "shareWithThemes": true
          }
        ]
      }
    ]
  },
  "window": {
    "width": 720,
    "height": 420,
    "minWidth": 480,
    "minHeight": 240
  },
  "features": [
    {
      "code": "main",
      "explain": "数据库客户端",
      "cmds": [
        "数据库",
        "database",
        "sql",
        "mysql",
        "sqlite"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "featured": true,
    "tags": [
      "数据库",
      "SQL",
      "MySQL",
      "PostgreSQL",
      "MongoDB",
      "TDengine"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png",
      "assets/market/screenshots/02-table-data.webp",
      "assets/market/screenshots/03-table-structure.webp"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5183/"
  },
  "backend": {
    "entry": "backend/index.cjs"
  }
}
