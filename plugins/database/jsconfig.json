{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": { "@db/*": ["src/js/*"] },
    "lib": ["ES2022", "DOM", "WebWorker"],
    "skipLibCheck": true
  },
  "include": ["src/js/**/*.js", "src/js/**/*.d.ts", "src/jsx/**/*.jsx", "src/entry.js"]
}
