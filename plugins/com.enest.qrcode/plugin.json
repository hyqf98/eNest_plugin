{
  "id": "com.enest.qrcode",
  "name": "二维码",
  "version": "1.1.0",
  "description": "二维码模板、PNG/SVG 导出、批量图集及多图离线识别。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "permissions": [
    "clipboard.read",
    "clipboard.write",
    "clipboard.readImage",
    "clipboard.writeImage",
    "shell.openExternal",
    "fs.read",
    "fs.write"
  ],
  "engines": {
    "enest": ">=0.1.0"
  },
  "features": [
    {
      "code": "main",
      "explain": "生成二维码",
      "cmds": [
        "二维码",
        "qrcode",
        "qr"
      ]
    },
    {
      "code": "decode",
      "explain": "识别二维码图片",
      "cmds": [
        "识别二维码",
        "decodeqr"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "二维码",
      "qr",
      "效率"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "window": {
    "width": 760,
    "height": 480,
    "minWidth": 420,
    "minHeight": 280
  },
  "contributes": {
    "settings": [
      {
        "id": "qrcode.preferences",
        "title": "二维码",
        "items": [
          {
            "key": "defaultSize",
            "type": "select",
            "label": "默认图片尺寸",
            "default": "256",
            "options": [
              {
                "label": "128",
                "value": "128"
              },
              {
                "label": "256",
                "value": "256"
              },
              {
                "label": "512",
                "value": "512"
              },
              {
                "label": "1024",
                "value": "1024"
              }
            ]
          },
          {
            "key": "defaultEcc",
            "type": "select",
            "label": "默认纠错等级",
            "default": "M",
            "options": [
              {
                "label": "L",
                "value": "L"
              },
              {
                "label": "M",
                "value": "M"
              },
              {
                "label": "Q",
                "value": "Q"
              },
              {
                "label": "H",
                "value": "H"
              }
            ]
          },
          {
            "key": "foreground",
            "type": "color",
            "label": "默认前景色",
            "default": "#000000"
          },
          {
            "key": "background",
            "type": "color",
            "label": "默认背景色",
            "default": "#ffffff"
          }
        ]
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5173/"
  }
}
