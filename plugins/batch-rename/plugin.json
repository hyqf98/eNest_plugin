{
  "id": "com.github.eNest.batch-rename",
  "name": "批量重命名",
  "version": "0.0.1",
  "description": "拖入多文件，查找替换（正则）/ 序号 / 日期 / 大小写 / 插入 / 删除片段 / 扩展名规则链实时预览（diff 高亮 + 冲突检测），确认后批量改名，支持撤销。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "其它",
  "icon": "assets/market/icon.svg",
  "permissions": [
    "fs.rename"
  ],
  "engines": {
    "enest": ">=0.1.0"
  },
  "features": [
    {
      "code": "main",
      "explain": "批量重命名文件",
      "cmds": [
        "重命名",
        "rename",
        "批量改名",
        "mm"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "重命名",
      "批量",
      "文件"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "window": {
    "width": 900,
    "height": 640,
    "minWidth": 460,
    "minHeight": 360
  },
  "development": {
    "main": "http://127.0.0.1:5174/"
  }
}
