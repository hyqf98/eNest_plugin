{
  "id": "com.github.eNest.sysguard",
  "name": "进程与端口",
  "version": "0.0.1",
  "description": "本机进程与端口巡检：概览仪表盘（CPU·内存数据卡 + 迷你趋势 + 阈值告警 + Top 进程）、双表联动、搜索、收藏置顶、结束进程危险确认、滚动曲线、刷新频率可调",
  "author": "eNest Labs",
  "main": "index.html",
  "views": {
    "default": "shell",
    "layouts": ["quick", "shell", "panel"],
    "panel": { "size": { "width": 320, "height": 248 } }
  },
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "sys.inspect",
    "sys.control",
    "clipboard.write"
  ],
  "window": {
    "width": 760,
    "height": 420,
    "minWidth": 480,
    "minHeight": 240
  },
  "features": [
    {
      "code": "main",
      "explain": "进程与端口巡检",
      "cmds": [
        "进程",
        "端口",
        "进程管理",
        "port",
        "jincheng"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "transparent",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "进程",
      "端口",
      "系统",
      "监控"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5202/"
  }
}
