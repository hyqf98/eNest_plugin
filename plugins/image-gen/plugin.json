{
  "id": "com.github.eNest.image-gen",
  "name": "AI 生图",
  "version": "0.0.1",
  "description": "对话式 AI 生图：多渠道接入 Images / Chat / Responses 三类协议，文生图与图生图会话流、提示词模板、生成记录预览库，一键下载与以图续作。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "设计",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "net.fetch",
    "backend.node"
  ],
  "net": {
    "allowInsecure": true
  },
  "window": {
    "width": 1180,
    "height": 800,
    "minWidth": 900,
    "minHeight": 600
  },
  "features": [
    {
      "code": "main",
      "explain": "AI 生图 / 文生图 / 图生图",
      "cmds": [
        "生图",
        "AI生图",
        "画图",
        "文生图",
        "图生图",
        "image-gen",
        "st"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "AI 绘画",
      "文生图",
      "图生图"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5221/"
  },
  "backend": {
    "entry": "backend/index.cjs"
  }
}
