        "settings": {
          "version": 1,
          "groups": [
            {
              "id": "colors",
              "title": "纸张与墨色",
              "description": "浅色与深色分别保存；透明边框会保留 Alpha。",
              "fields": [
                {
                  "key": "colorBg",
                  "label": "纸张底色",
                  "type": "token",
                  "default": "#e2e5e2",
                  "binding": {
                    "target": "token",
                    "key": "--bg"
                  }
                },
                {
                  "key": "colorSurface",
                  "label": "卡纸颜色",
                  "type": "token",
                  "default": "#f0f1ec",
                  "binding": {
                    "target": "token",
                    "key": "--surface"
                  }
                },
                {
                  "key": "colorSurface2",
                  "label": "次级卡纸",
                  "type": "token",
                  "default": "#d7dcd9",
                  "binding": {
                    "target": "token",
                    "key": "--surface-2"
                  }
                },
                {
                  "key": "colorSurface3",
                  "label": "叠层卡纸",
                  "type": "token",
                  "default": "#c8cfcc",
                  "binding": {
                    "target": "token",
                    "key": "--surface-3"
                  }
                },
                {
                  "key": "colorText",
                  "label": "墨色文字",
                  "type": "token",
                  "default": "#293330",
                  "binding": {
                    "target": "token",
                    "key": "--text"
                  }
                },
                {
                  "key": "colorText2",
                  "label": "次要文字",
                  "type": "token",
                  "default": "#46544f",
                  "binding": {
                    "target": "token",
                    "key": "--text-2"
                  }
                },
                {
                  "key": "colorText3",
                  "label": "弱化文字",
                  "type": "token",
                  "default": "#495750",
                  "binding": {
                    "target": "token",
                    "key": "--text-3"
                  }
                },
                {
                  "key": "colorAccent",
                  "label": "马克笔强调色",
                  "type": "token",
                  "default": "#8d5f50",
                  "binding": {
                    "target": "token",
                    "key": "--accent"
                  }
                },
                {
                  "key": "colorOk",
                  "label": "成功色",
                  "type": "token",
                  "default": "#4e705b",
                  "binding": {
                    "target": "token",
                    "key": "--ok"
                  }
                },
                {
                  "key": "colorDanger",
                  "label": "危险色",
                  "type": "token",
                  "default": "#a74f47",
                  "binding": {
                    "target": "token",
                    "key": "--danger"
                  }
                },
                {
                  "key": "colorBorder",
                  "label": "描边",
                  "type": "token",
                  "default": "#bec8c2",
                  "binding": {
                    "target": "token",
                    "key": "--border"
                  }
                },
                {
                  "key": "colorBorderStrong",
                  "label": "强描边",
                  "type": "token",
                  "default": "#8c9c93",
                  "binding": {
                    "target": "token",
                    "key": "--border-strong"
                  }
                },
                {
                  "key": "colorLink",
                  "label": "链接颜色",
                  "type": "token",
                  "default": "#375864",
                  "binding": {
                    "target": "token",
                    "key": "--link"
                  }
                }
              ]
            },
            {
              "id": "background",
              "title": "纸面背景与宿主开屏",
              "description": "纸灰、灰蓝、鼠尾草随浅深模式变化。目录、已安装、详情和样式台自行绘制整页轻量漂移；真正开屏与全局设置入口由宿主管理。",
              "fields": [
                {
                  "key": "backgroundPalette",
                  "label": "纸面色板",
                  "type": "select",
                  "default": "markerStrokes",
                  "presentation": "cards",
                  "options": [
                    {
                      "label": "纸灰",
                      "value": "markerStrokes",
                      "preview": {
                        "kind": "swatch",
                        "stops": [
                          "color-mix(in srgb, var(--bg) 74%, #88928b)",
                          "color-mix(in srgb, var(--surface-2) 88%, #87938e)"
                        ]
                      }
                    },
                    {
                      "label": "灰蓝",
                      "value": "sketchPaper",
                      "preview": {
                        "kind": "swatch",
                        "stops": [
                          "color-mix(in srgb, var(--bg) 76%, #7c919c)",
                          "color-mix(in srgb, var(--surface-2) 84%, #7d909a)"
                        ]
                      }
                    },
                    {
                      "label": "鼠尾草",
                      "value": "chalkBoard",
                      "preview": {
                        "kind": "swatch",
                        "stops": [
                          "color-mix(in srgb, var(--bg) 76%, #849789)",
                          "color-mix(in srgb, var(--surface-2) 84%, #7e9487)"
                        ]
                      }
                    }
                  ],
                  "binding": {
                    "target": "background",
                    "key": "palette"
                  },
                  "help": "三套低饱和纸面，浅色略压亮度、深色保留灰阶；彩条只作页边点缀。"
                },
                {
                  "key": "backgroundEffect",
                  "label": "宿主额外光效",
                  "type": "select",
                  "default": "none",
                  "presentation": "segmented",
                  "help": "仅控制壳层的额外光效，默认关闭。不透明主题页另绘轻量纸面漂移，受动画强度控制，不依赖壳背景。",
                  "options": [
                    {
                      "label": "仅纸面漂移",
                      "value": "none",
                      "description": "关闭壳层额外光效；主题页保留随动画档位控制的柔和漂移。"
                    },
                    {
                      "label": "极光绸缎",
                      "value": "aurora",
                      "description": "在壳层叠加绸带光效，不改变主题页的纸面。"
                    },
                    {
                      "label": "液态波纹",
                      "value": "ripple",
                      "description": "在壳层叠加液态光效，不改变主题页的纸面。"
                    },
                    {
                      "label": "空间折叠",
                      "value": "fold",
                      "description": "在壳层叠加折面光效，不改变主题页的纸面。"
                    },
                    {
                      "label": "引力光环",
                      "value": "orbit",
                      "description": "在壳层叠加光环，不改变主题页的纸面。"
                    }
                  ],
                  "binding": {
                    "target": "background",
                    "key": "effect"
                  }
                },
                {
                  "key": "backgroundOpacity",
                  "label": "纸面铺色",
                  "type": "slider",
                  "default": 0.76,
                  "min": 0,
                  "max": 1,
                  "step": 0.02,
                  "help": "同步调整壳层与主题页面的色板铺色；横线纸纹、文字与卡纸不被调暗。",
                  "binding": {
                    "target": "background",
                    "key": "opacity"
                  }
                },
                {
                  "key": "splashType",
                  "label": "宿主开屏样式",
                  "type": "select",
                  "default": "paper",
                  "options": [
                    {
                      "label": "纸页描线",
                      "value": "paper",
                      "description": "宿主用当前纸面与墨色播放纸页、铅笔描线的真实启动动画。"
                    },
                    {
                      "label": "品牌动画",
                      "value": "brand",
                      "description": "使用宿主品牌开屏。"
                    },
                    {
                      "label": "关闭",
                      "value": "none",
                      "description": "关闭装饰性开屏，仍等待宿主与首页就绪。"
                    },
                    {
                      "label": "自定义图片",
                      "value": "image",
                      "description": "由宿主在真实开屏中展示本地图片，可单独调整透明度。"
                    }
                  ],
                  "binding": {
                    "target": "splash",
                    "key": "type"
                  },
                  "help": "真实启动动画只由宿主播放一次；首页不再重复全屏开屏。"
                },
                {
                  "key": "splashMedia",
                  "label": "开屏图片",
                  "type": "media",
                  "default": null,
                  "binding": {
                    "target": "splash",
                    "key": "media"
                  },
                  "visibleWhen": {
                    "field": "splashType",
                    "equals": "image"
                  }
                },
                {
                  "key": "splashOpacity",
                  "label": "开屏图片不透明度",
                  "type": "slider",
                  "default": 0.55,
                  "min": 0,
                  "max": 1,
                  "step": 0.05,
                  "binding": {
                    "target": "splash",
                    "key": "opacity"
                  },
                  "visibleWhen": {
                    "field": "splashType",
                    "equals": "image"
                  }
                }
              ]
            },
            {
              "id": "typography",
              "title": "手写与字号",
              "fields": [
                {
                  "key": "fontLatin",
                  "label": "英文字体",
                  "type": "font",
                  "default": "",
                  "binding": {
                    "target": "font",
                    "key": "latin"
                  },
                  "options": [
                    {
                      "label": "默认（Avenir Next）",
                      "value": ""
                    },
                    {
                      "label": "手札体 中文手写",
                      "value": "\"Hannotate SC\", \"HanziPen SC\", \"PingFang SC\", sans-serif"
                    },
                    {
                      "label": "Marker Felt 马克笔",
                      "value": "\"Marker Felt\", \"Bradley Hand\", \"Hannotate SC\", sans-serif"
                    },
                    {
                      "label": "Bradley Hand 英文手写",
                      "value": "\"Bradley Hand\", \"Chalkboard SE\", \"Hannotate SC\", cursive"
                    }
                  ]
                },
                {
                  "key": "fontCjk",
                  "label": "中文字体",
                  "type": "font",
                  "default": "",
                  "binding": {
                    "target": "font",
                    "key": "cjk"
                  },
                  "options": [
                    {
                      "label": "默认（苹方）",
                      "value": ""
                    },
                    {
                      "label": "苹方",
                      "value": "\"PingFang SC\", \"Hiragino Sans GB\", sans-serif"
                    },
                    {
                      "label": "楷体手写",
                      "value": "\"Kaiti SC\", \"STKaiti\", \"KaiTi\", serif"
                    },
                    {
                      "label": "霞鹜文楷",
                      "value": "\"LXGW WenKai\", \"LXGW WenKai Screen\", \"Kaiti SC\", serif"
                    }
                  ]
                },
                {
                  "key": "fontMono",
                  "label": "代码与数字",
                  "type": "font",
                  "default": "\"JetBrains Mono\", \"SF Mono\", ui-monospace, monospace",
                  "binding": {
                    "target": "font",
                    "key": "mono"
                  }
                },
                {
                  "key": "fontScale",
                  "label": "字号比例",
                  "type": "slider",
                  "default": 1,
                  "min": 0.9,
                  "max": 1.3,
                  "step": 0.05,
                  "help": "整体缩放全壳字号，90%-130%",
                  "binding": {
                    "target": "font",
                    "key": "scale"
                  }
                }
              ]
            },
            {
              "id": "layout",
              "title": "内容布局与动画",
              "fields": [
                {
                  "key": "contentWidth",
                  "label": "内容宽度",
                  "type": "slider",
                  "default": 1440,
                  "min": 640,
                  "max": 1920,
                  "step": 10,
                  "binding": {
                    "target": "layout",
                    "key": "contentWidth"
                  }
                },
                {
                  "key": "density",
                  "label": "内容密度",
                  "type": "slider",
                  "default": 1,
                  "min": 0.8,
                  "max": 1.2,
                  "step": 0.01,
                  "binding": {
                    "target": "layout",
                    "key": "density"
                  }
                },
                {
                  "key": "gap",
                  "label": "卡片间距",
                  "type": "slider",
                  "default": 18,
                  "min": 0,
                  "max": 32,
                  "step": 1,
                  "binding": {
                    "target": "layout",
                    "key": "gap"
                  }
                },
                {
                  "key": "columns",
                  "label": "目录列数",
                  "type": "slider",
                  "default": 3,
                  "min": 1,
                  "max": 6,
                  "step": 1,
                  "binding": {
                    "target": "layout",
                    "key": "columns"
                  }
                },
                {
                  "key": "motion",
                  "label": "动画强度",
                  "type": "select",
                  "default": "medium",
                  "help": "低档保留静态纸面，中档持续轻柔漂移，高档略增位移与内容入场；隐藏页面暂停，系统减少动态效果时静止。",
                  "options": [
                    {
                      "label": "低",
                      "value": "low"
                    },
                    {
                      "label": "中",
                      "value": "medium"
                    },
                    {
                      "label": "高",
                      "value": "high"
                    }
                  ],
                  "binding": {
                    "target": "animation",
                    "key": "level"
                  }
                }
              ],
              "description": "仅调整主题内容布局。全局标签栏、圆轨和设置入口由宿主统一管理。"
            },
            {
              "id": "surfaces",
              "title": "描边、圆角与通知",
              "description": "控件、卡纸与面板共用同一套手绘圆角与描边；通知沿用同一外观语言。",
              "fields": [
                {
                  "key": "radius",
                  "label": "控件圆角",
                  "type": "slider",
                  "default": 12,
                  "min": 0,
                  "max": 24,
                  "step": 1,
                  "binding": {
                    "target": "component",
                    "key": "controlRadius"
                  }
                },
                {
                  "key": "cardRadius",
                  "label": "卡片圆角",
                  "type": "slider",
                  "default": 18,
                  "min": 0,
                  "max": 32,
                  "step": 1,
                  "binding": {
                    "target": "component",
                    "key": "cardRadius"
                  }
                },
                {
                  "key": "panelRadius",
                  "label": "面板圆角",
                  "type": "slider",
                  "default": 24,
                  "min": 0,
                  "max": 40,
                  "step": 1,
                  "binding": {
                    "target": "component",
                    "key": "panelRadius"
                  }
                },
                {
                  "key": "borderWidth",
                  "label": "描边宽度",
                  "type": "slider",
                  "default": 2,
                  "min": 0,
                  "max": 6,
                  "step": 0.5,
                  "binding": {
                    "target": "component",
                    "key": "borderWidth"
                  }
                },
                {
                  "key": "notificationLayout",
                  "label": "通知布局",
                  "type": "select",
                  "default": "card",
