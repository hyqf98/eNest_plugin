              "--accent": "#fb923c",
              "--ok": "#4ade80",
              "--danger": "#f87171",
              "--border": "#44403c",
              "--border-strong": "#78716c",
              "--link": "#93c5fd"
            },
            "fonts": {
              "body": "\"Avenir Next\", \"PingFang SC\", \"Hiragino Sans GB\", system-ui, sans-serif",
              "heading": "\"Hannotate SC\", \"HanziPen SC\", \"Bradley Hand\", \"Wawati SC\", \"PingFang SC\", sans-serif",
              "mono": "\"JetBrains Mono\", \"SF Mono\", ui-monospace, monospace",
              "scale": 1,
              "latin": "",
              "cjk": ""
            },
            "components": {
              "controlRadius": 6,
              "cardRadius": 3,
              "panelRadius": 4,
              "borderWidth": 2
            },
            "background": {
              "media": null,
              "kind": "gradient",
              "palette": "warmSand",
              "color": "#1c1917",
              "opacity": 1,
              "fit": "cover",
              "effect": "none",
              "texture": "paper",
              "intensity": 0.42,
              "speed": 0.6,
              "direction": 24,
              "warmth": 0.34,
              "grain": 0.14,
              "scale": 1,
              "wash": 0.18
            },
            "layout": {
              "variant": "sketchbook",
              "tabStyle": "classic",
              "tabOpacity": 1,
              "tabAutoHide": false,
              "density": 1,
              "gap": 16,
              "sidebarWidth": 280,
              "contentWidth": 1500,
