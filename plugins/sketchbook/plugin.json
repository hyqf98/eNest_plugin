{
  "id": "com.github.eNest.sketchbook",
  "name": "素描本",
  "version": "1.0.1",
  "description": "手绘纸面主题：纸灰、灰蓝、鼠尾草三套浅深色板，保留手写字、抖动描边与胶带装订；整页低负载漂移，开屏由宿主统一呈现。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "设计",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.2.0"
  },
  "permissions": [],
  "window": {
    "width": 880,
    "height": 620,
    "minWidth": 420,
    "minHeight": 300
  },
  "features": [
    {
      "code": "main",
      "explain": "主题样式台：按钮、输入框、图标与小窗样式",
      "cmds": [
        "素描本",
        "sketchbook",
        "主题样式"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "主题",
      "手绘",
      "彩条",
      "设计"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-market.jpg",
      "assets/market/screenshots/02-detail.jpg",
      "assets/market/screenshots/03-workbench.jpg",
      "assets/market/screenshots/04-dark.jpg"
    ]
  },
  "contributes": {
    "themePacks": [
      {
        "schemaVersion": 2,
        "version": 2,
        "id": "sketchbook",
        "name": "素描本",
        "source": "com.github.eNest.sketchbook",
        "mode": "system",
        "description": "柔和纸面、少量彩墨与抖动描边，配套整页漂移背景；手写标题、胶带与装订拼贴保留，纸页开屏交给宿主。",
        "tokens": {},
        "palettes": [
          {
            "id": "markerStrokes",
            "name": "纸灰",
            "css": "radial-gradient(ellipse 78% 86% at 12% 26%, color-mix(in srgb, var(--bg) 74%, #88928b), transparent 78%), linear-gradient(152deg, var(--bg), color-mix(in srgb, var(--surface-2) 88%, #87938e))",
            "swatch": "linear-gradient(135deg, color-mix(in srgb, var(--bg) 74%, #88928b), color-mix(in srgb, var(--surface-2) 88%, #87938e))"
          },
          {
            "id": "sketchPaper",
            "name": "灰蓝",
            "css": "radial-gradient(ellipse 78% 86% at 12% 26%, color-mix(in srgb, var(--bg) 76%, #7c919c), transparent 78%), linear-gradient(152deg, var(--bg), color-mix(in srgb, var(--surface-2) 84%, #7d909a))",
            "swatch": "linear-gradient(135deg, color-mix(in srgb, var(--bg) 76%, #7c919c), color-mix(in srgb, var(--surface-2) 84%, #7d909a))"
          },
          {
            "id": "chalkBoard",
            "name": "鼠尾草",
            "css": "radial-gradient(ellipse 78% 86% at 12% 26%, color-mix(in srgb, var(--bg) 76%, #849789), transparent 78%), linear-gradient(152deg, var(--bg), color-mix(in srgb, var(--surface-2) 84%, #7e9487))",
            "swatch": "linear-gradient(135deg, color-mix(in srgb, var(--bg) 76%, #849789), color-mix(in srgb, var(--surface-2) 84%, #7e9487))"
          }
        ],
        "variants": {
          "light": {
            "tokens": {
              "--bg": "#e2e5e2",
              "--surface": "#f0f1ec",
              "--surface-2": "#d7dcd9",
