            },
            "animation": "medium"
          }
        },
        "settings": {
          "version": 3,
          "groups": [
            {
              "id": "appearance",
              "title": "外观",
              "description": "先挑一套桌面，再按需微调；其余颜色跟随预设派生。",
              "fields": [
                {
                  "key": "deskPreset",
                  "label": "桌面",
                  "type": "select",
                  "default": "warmSand",
                  "presentation": "cards",
                  "options": [
                    {
                      "label": "暖沙日光",
                      "value": "warmSand",
                      "description": "奶油纸配落日暖光，默认。",
                      "preview": {
                        "kind": "swatch",
                        "stops": [
                          "linear-gradient(135deg, #fdfcf9, #efe7d8)",
                          "color-mix(in srgb, var(--accent) 34%, transparent)"
                        ]
                      }
                    },
                    {
                      "label": "晨雾中性",
                      "value": "morningMist",
                      "description": "极淡灰阶，最克制。",
                      "preview": {
                        "kind": "swatch",
                        "stops": [
                          "linear-gradient(135deg, #fafaf9, #e5e3de)",
                          "color-mix(in srgb, var(--accent) 34%, transparent)"
                        ]
                      }
                    },
                    {
                      "label": "陶土纸感",
                      "value": "terracotta",
                      "description": "米白到陶土，最暖。",
                      "preview": {
                        "kind": "swatch",
                        "stops": [
                          "linear-gradient(135deg, #fdf6ee, #efdcc6)",
                          "color-mix(in srgb, var(--accent) 34%, transparent)"
                        ]
                      }
                    },
                    {
                      "label": "冷雾青灰",
                      "value": "coolMist",
                      "description": "白到冷灰，带天光。",
                      "preview": {
                        "kind": "swatch",
                        "stops": [
                          "linear-gradient(135deg, #f8fafc, #e2e8ec)",
                          "color-mix(in srgb, var(--accent) 34%, transparent)"
                        ]
                      }
                    }
                  ],
                  "binding": {
                    "target": "background",
                    "key": "palette"
                  },
                  "help": "四套桌面渐变，切换即时生效；深色模式各有对应版本。"
                },
                {
                  "key": "colorSurface",
                  "label": "纸张",
                  "type": "token",
                  "default": "#ffffff",
                  "help": "索引卡与活页的底色。",
                  "binding": {
                    "target": "token",
                    "key": "--surface"
                  }
                },
                {
                  "key": "colorText",
                  "label": "墨色",
                  "type": "token",
                  "default": "#292524",
                  "help": "正文与标题。",
                  "binding": {
                    "target": "token",
                    "key": "--text"
                  }
                },
                {
                  "key": "colorAccent",
                  "label": "马克笔",
                  "type": "token",
                  "default": "#c2410c",
                  "help": "主操作、选中态与手绘记号只用这一支。",
                  "binding": {
                    "target": "token",
                    "key": "--accent"
                  }
                },
                {
                  "key": "colorOk",
                  "label": "盖章绿",
                  "type": "token",
                  "default": "#15803d",
                  "binding": {
                    "target": "token",
                    "key": "--ok"
                  }
                },
                {
                  "key": "colorDanger",
                  "label": "盖章红",
                  "type": "token",
                  "default": "#b91c1c",
                  "binding": {
                    "target": "token",
                    "key": "--danger"
                  }
                }
              ]
            },
            {
              "id": "layout",
              "title": "版面",
              "description": "纸片的尺寸节奏与动效。",
              "fields": [
                {
                  "key": "columns",
                  "label": "列数",
                  "type": "slider",
                  "default": 4,
                  "min": 2,
                  "max": 6,
                  "step": 1,
                  "binding": {
                    "target": "layout",
                    "key": "columns"
                  },
                  "help": "列数决定纸片铺法；窗口变窄会自动减少。"
                },
                {
                  "key": "gap",
                  "label": "纸片间距",
                  "type": "slider",
                  "default": 16,
                  "min": 0,
                  "max": 32,
                  "step": 1,
                  "binding": {
                    "target": "layout",
                    "key": "gap"
                  },
                  "help": "越小越像摊满桌面，越大越像整理过的档案。"
                },
                {
                  "key": "density",
                  "label": "纸边距",
                  "type": "slider",
                  "default": 1,
                  "min": 0.8,
                  "max": 1.2,
                  "step": 0.02,
                  "binding": {
                    "target": "layout",
                    "key": "density"
                  },
                  "help": "纸片内边距与行距一起缩放。"
                },
                {
                  "key": "motion",
                  "label": "动效",
                  "type": "select",
                  "default": "medium",
                  "presentation": "segmented",
                  "options": [
                    {
                      "label": "静止",
                      "value": "low"
                    },
                    {
                      "label": "自然",
                      "value": "medium"
                    },
                    {
                      "label": "活泼",
                      "value": "high"
                    }
                  ],
                  "binding": {
                    "target": "animation",
                    "key": "level"
                  },
                  "help": "活泼档下所有纸片描边会轻微沸腾。"
                }
              ]
            },
            {
              "id": "hand",
              "title": "手写",
              "description": "标题与正文可以分开选手写体。",
              "fields": [
                {
                  "key": "fontLatin",
                  "label": "英文手写",
                  "type": "font",
                  "default": "",
                  "options": [
                    {
                      "label": "系统默认",
                      "value": ""
                    },
                    {
                      "label": "手札体",
                      "value": "\"Hannotate SC\", \"HanziPen SC\", \"PingFang SC\", sans-serif"
                    },
                    {
                      "label": "记号笔",
                      "value": "\"Marker Felt\", \"Bradley Hand\", \"Hannotate SC\", sans-serif"
                    },
                    {
                      "label": "粉笔手写",
                      "value": "\"Bradley Hand\", \"Chalkboard SE\", \"Hannotate SC\", cursive"
                    }
                  ],
                  "binding": {
                    "target": "font",
                    "key": "latin"
                  }
                },
                {
                  "key": "fontCjk",
                  "label": "中文手写",
                  "type": "font",
                  "default": "",
                  "options": [
                    {
                      "label": "系统默认",
                      "value": ""
                    },
                    {
                      "label": "黑体",
                      "value": "\"PingFang SC\", \"Hiragino Sans GB\", sans-serif"
                    },
                    {
                      "label": "楷体",
                      "value": "\"Kaiti SC\", \"STKaiti\", \"KaiTi\", serif"
                    },
                    {
                      "label": "文楷",
                      "value": "\"LXGW WenKai\", \"LXGW WenKai Screen\", \"Kaiti SC\", serif"
                    }
                  ],
                  "binding": {
                    "target": "font",
                    "key": "cjk"
                  }
                },
                {
                  "key": "fontScale",
                  "label": "字号",
                  "type": "slider",
                  "default": 1,
                  "min": 0.9,
                  "max": 1.3,
                  "step": 0.02,
                  "binding": {
                    "target": "font",
                    "key": "scale"
                  }
                }
              ]
            },
            {
              "id": "detail",
              "title": "细节",
              "description": "手绘描边、纸角与通知外观。圆角按「纸角」理解，不是胶囊。",
              "fields": [
                {
                  "key": "borderWidth",
                  "label": "描边粗细",
                  "type": "slider",
                  "default": 2,
                  "min": 1,
                  "max": 5,
                  "step": 0.5,
                  "binding": {
                    "target": "component",
                    "key": "borderWidth"
                  },
                  "help": "手绘描边的基准线宽；滤镜会把它推得不均匀。"
                },
                {
                  "key": "cardRadius",
                  "label": "纸角",
                  "type": "slider",
                  "default": 3,
                  "min": 0,
                  "max": 20,
                  "step": 1,
                  "binding": {
                    "target": "component",
                    "key": "cardRadius"
                  },
                  "help": "纸是直角物件；这里调的是纸角被磨圆的程度。"
                },
                {
                  "key": "notificationLayout",
                  "label": "通知版式",
                  "type": "select",
                  "default": "card",
                  "presentation": "segmented",
                  "options": [
                    {
                      "label": "纸卡",
                      "value": "card"
                    },
                    {
                      "label": "紧凑",
                      "value": "compact"
                    },
                    {
                      "label": "横幅",
                      "value": "banner"
                    }
                  ],
                  "binding": {
                    "target": "notification",
                    "key": "layout"
                  }
                },
                {
                  "key": "notificationShadow",
                  "label": "通知投影",
                  "type": "select",
                  "default": "soft",
                  "presentation": "segmented",
                  "options": [
                    {
                      "label": "无",
                      "value": "none"
                    },
                    {
                      "label": "轻",
                      "value": "soft"
                    },
                    {
                      "label": "实",
                      "value": "raised"
                    }
                  ],
                  "binding": {
                    "target": "notification",
                    "key": "shadow"
                  }
                }
              ]
            }
          ]
        },
        "home": {
          "source": "com.github.eNest.sketchbook",
          "id": "home",
          "variant": "sketchbook"
        },
        "quick": {
          "version": 1,
          "entry": "quick/sketchbook.html"
        },
        "settingsPage": {
          "version": 1,
          "entry": "settings/preferences.html"
        }
      }
    ],
    "homePages": [
