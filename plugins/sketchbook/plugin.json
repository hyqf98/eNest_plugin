              "--ok": "#15803d",
              "--danger": "#b91c1c",
              "--border": "#d6d3d1",
              "--border-strong": "#a8a29e",
              "--link": "#1d4ed8"
            },
            "fonts": {
              "body": "\"Avenir Next\", \"PingFang SC\", \"Hiragino Sans GB\", system-ui, sans-serif",
              "heading": "\"Hannotate SC\", \"HanziPen SC\", \"Bradley Hand\", \"Wawati SC\", \"PingFang SC\", sans-serif",
              "mono": "\"JetBrains Mono\", \"SF Mono\", ui-monospace, monospace",
              "scale": 1,
              "latin": "",
              "cjk": ""
            },
            "components": {
              "controlRadius": 6,
              "cardRadius": 3,
              "panelRadius": 4,
              "borderWidth": 2
            },
            "background": {
