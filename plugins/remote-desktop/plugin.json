{
  "id": "com.github.eNest.remote-desktop",
  "name": "远程桌面",
  "version": "1.2.0",
  "description": "VNC / RDP 远程桌面：资产管理、SSH 隧道、多会话画布、剪贴板互通与连接诊断",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.2.0"
  },
  "permissions": [
    "net.socket",
    "ssh.session",
    "clipboard.read",
    "clipboard.write",
    "clipboard.readImage",
    "clipboard.writeImage",
    "pin.create",
    "shell.openExternal",
    "notify",
    "backend.node"
  ],
  "contributes": {
    "settings": [
      {
        "id": "rdp.prefs",
        "title": "远程桌面",
        "items": [
          {
            "key": "followShellTheme",
            "type": "switch",
            "label": "跟随壳子主题",
            "default": true
          },
          {
            "key": "viewOnly",
            "type": "switch",
            "label": "默认只读（禁止远端键鼠）",
            "default": false
          },
          {
            "key": "quality",
            "type": "select",
            "label": "画质档位",
            "options": [
              {
                "value": "auto",
                "label": "自动"
              },
              {
                "value": "smooth",
                "label": "流畅"
              },
              {
                "value": "sharp",
                "label": "清晰"
              }
            ],
            "default": "auto"
          }
        ]
      }
    ]
  },
  "window": {
    "minWidth": 560,
    "minHeight": 360
  },
  "features": [
    {
      "code": "main",
      "explain": "远程桌面连接与管理",
      "cmds": [
        "远程桌面",
        "rdp",
        "vnc",
        "remote desktop"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "远程桌面",
      "VNC",
      "RDP",
      "开发",
      "运维"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5197/"
  },
  "backend": {
    "entry": "backend/index.cjs"
  }
}
