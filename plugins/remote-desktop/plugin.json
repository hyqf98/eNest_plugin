{
  "id": "com.github.eNest.remote-desktop",
  "name": "远程桌面",
  "version": "0.0.1",
  "description": "VNC / RDP 远程桌面：资产管理、SSH 隧道、多会话画布、剪贴板互通与连接诊断",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "net.socket",
    "clipboard.read",
    "clipboard.write",
    "clipboard.readImage",
    "clipboard.writeImage",
    "pin.create",
    "shell.openExternal",
    "notify",
    "backend.node"
  ],
  "window": {
    "minWidth": 560,
    "minHeight": 360
  },
  "features": [
    {
      "code": "main",
      "explain": "远程桌面连接与管理",
      "cmds": [
        "远程桌面",
        "rdp",
        "vnc",
        "remote desktop"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "远程桌面",
      "VNC",
      "RDP",
      "开发",
      "运维"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5197/"
  },
  "backend": {
    "entry": "backend/index.cjs"
  }
}
