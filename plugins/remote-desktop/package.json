{
  "name": "remote-desktop",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5197 --strictPort",
    "build": "node ../../scripts/build-plugin.mjs com.github.eNest.remote-desktop",
    "pack": "node ../../scripts/pack-plugin.mjs com.github.eNest.remote-desktop",
    "prod": "node ../../scripts/build-plugin.mjs com.github.eNest.remote-desktop"
  },
  "dependencies": {
    "@enest/plugin-kit": "1.0.0",
    "@enest/ssh-backend": "1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  },
  "enestBackend": {
    "entry": "backend/index.ts",
    "dependencies": [
      "ssh2"
    ],
    "optionalExcluded": [
      "cpu-features",
      "nan"
    ]
  }
}
