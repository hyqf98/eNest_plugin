{
  "id": "com.example.hello",
  "name": "Hello 示例",
  "version": "1.0.1",
  "description": "eNest 标准插件骨架：manifest + 静态资源 + 全幅渲染。",
  "author": "eNest",
  "main": "index.html",
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "permissions": [],
  "engines": {
    "enest": ">=0.1.0"
  },
  "features": [
    {
      "code": "main",
      "explain": "打开 Hello",
      "cmds": [
        "hello",
        "你好"
      ]
    },
    {
      "code": "hello",
      "explain": "首页卡片入口",
      "cmds": [
        "问候"
      ]
    }
  ],
  "contributes": {
    "homeCards": [
      {
        "id": "hello-card",
        "title": "Hello 快捷入口",
        "glyph": "H",
        "color": "#7aa2ff",
        "explain": "从首页一键打开 Hello 插件",
        "openCode": "hello"
      }
    ],
    "railEntries": [
      {
        "id": "hello-rail",
        "glyph": "H",
        "color": "#7aa2ff",
        "title": "Hello",
        "openCode": "hello"
      }
    ]
  },
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "示例",
      "入门"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5173/"
  }
}
