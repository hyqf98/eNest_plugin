{
  "id": "com.enest.code-shot",
  "name": "代码截图",
  "version": "1.0.0",
  "description": "粘贴代码生成高亮截图卡片：多语言着色、跟随主题配色、macOS 窗口栏样式，复制 / 保存 PNG / 2x 高清。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "设计",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "clipboard.writeImage",
    "pin.create",
    "clipboard.read"
  ],
  "window": {
    "width": 980,
    "height": 620,
    "minWidth": 420,
    "minHeight": 300
  },
  "features": [
    {
      "code": "main",
      "explain": "代码截图生成",
      "cmds": [
        "代码截图",
        "codeshot",
        "dm"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "代码",
      "截图",
      "高亮",
      "分享"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "contributes": {
    "settings": [
      {
        "id": "code-shot.preferences",
        "title": "代码截图",
        "items": [
          {
            "key": "followShellTheme",
            "type": "boolean",
            "label": "跟随壳子主题",
            "default": true
          },
          {
            "key": "autoDetect",
            "type": "boolean",
            "label": "自动识别语言",
            "default": true
          },
          {
            "key": "scale2x",
            "type": "boolean",
            "label": "默认以 2x 高清导出",
            "default": true
          }
        ]
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5173/"
  }
}
