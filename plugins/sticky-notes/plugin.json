{
  "id": "com.github.eNest.sticky-notes",
  "name": "备忘录",
  "version": "1.3.0",
  "description": "快速记录、Markdown 预览、颜色筛选、标签整理、归档回收与本地备份。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "permissions": [
    "clipboard.write"
  ],
  "engines": {
    "enest": ">=0.1.0"
  },
  "features": [
    {
      "code": "main",
      "explain": "打开备忘录",
      "cmds": [
        "备忘录",
        "memo",
        "便签"
      ]
    }
  ],
  "contributes": {
    "homeCards": [
      {
        "id": "sticky-notes-card",
        "title": "备忘录",
        "glyph": "记",
        "color": "#f5a524",
        "explain": "多张便签随手记，彩色标签、置顶、自动保存",
        "openCode": "main"
      }
    ],
    "settings": [
      {
        "id": "sticky-notes.preferences",
        "title": "备忘录",
        "items": [
          {
            "key": "defaultColor",
            "type": "select",
            "label": "新笔记颜色",
            "default": "#cfa467",
            "options": [
              {
                "label": "麦黄",
                "value": "#cfa467"
              },
              {
                "label": "青绿",
                "value": "#7fa894"
              },
              {
                "label": "暖红",
                "value": "#b78180"
              },
              {
                "label": "雾蓝",
                "value": "#7b9ebc"
              },
              {
                "label": "藤紫",
                "value": "#a592b7"
              }
            ]
          },
          {
            "key": "defaultLayout",
            "type": "select",
            "label": "桌面笔记视图",
            "default": "list",
            "options": [
              {
                "label": "列表",
                "value": "list"
              },
              {
                "label": "卡片",
                "value": "grid"
              }
            ]
          }
        ]
      }
    ]
  },
  "market": {
    "tags": [
      "备忘录",
      "便签",
      "笔记"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5201/"
  }
}
