{
  "id": "com.github.eNest.timestamp",
  "name": "时间戳",
  "version": "0.0.1",
  "description": "时间戳与时区转换、多时区时钟、格式模板、批量转换、日期加减与时间差。",
  "author": "eNest Labs",
  "main": "index.html",
  "views": {
    "layouts": ["quick", "shell", "panel"],
    "default": "shell",
    "panel": { "size": { "width": 320, "height": 240 } }
  },
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "clipboard.write",
    "shell.openExternal"
  ],
  "window": {
    "width": 760,
    "height": 480,
    "minWidth": 420,
    "minHeight": 280
  },
  "features": [
    {
      "code": "main",
      "explain": "时间戳与日期转换",
      "cmds": [
        "时间戳",
        "ts",
        "timestamp"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "transparent",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "时间戳",
      "开发",
      "日期"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5204/"
  }
}
