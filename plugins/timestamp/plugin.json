{
  "id": "com.github.eNest.timestamp",
  "name": "时间戳",
  "version": "1.3.0",
  "description": "时间戳与时区转换、多时区时钟、格式模板、批量转换、日期加减与时间差。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.1.0"
  },
  "permissions": [
    "clipboard.write",
    "shell.openExternal"
  ],
  "window": {
    "width": 760,
    "height": 480,
    "minWidth": 420,
    "minHeight": 280
  },
  "features": [
    {
      "code": "main",
      "explain": "时间戳与日期转换",
      "cmds": [
        "时间戳",
        "ts",
        "timestamp"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "时间戳",
      "开发",
      "日期"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "contributes": {
    "settings": [
      {
        "id": "timestamp.preferences",
        "title": "时间戳",
        "items": [
          {
            "key": "timeZone",
            "type": "text",
            "label": "默认 IANA 时区",
            "default": "Asia/Shanghai"
          },
          {
            "key": "defaultUnit",
            "type": "select",
            "label": "默认输入单位",
            "default": "auto",
            "options": [
              {
                "label": "自动识别",
                "value": "auto"
              },
              {
                "label": "秒",
                "value": "s"
              },
              {
                "label": "毫秒",
                "value": "ms"
              }
            ]
          },
          {
            "key": "batchFormat",
            "type": "select",
            "label": "批量输出格式",
            "default": "date",
            "options": [
              {
                "label": "所选时区日期",
                "value": "date"
              },
              {
                "label": "ISO UTC",
                "value": "iso"
              },
              {
                "label": "秒",
                "value": "s"
              },
              {
                "label": "毫秒",
                "value": "ms"
              }
            ]
          }
        ]
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5204/"
  }
}
