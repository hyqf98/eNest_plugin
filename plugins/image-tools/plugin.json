{
  "id": "com.github.eNest.image-tools",
  "name": "图片工具箱",
  "version": "1.3.0",
  "description": "图片压缩、格式转换、批量缩放、裁剪旋转、文字水印、EXIF 查看、色板提取与贴图预览。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "媒体",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.2.3"
  },
  "permissions": [
    "pin.create",
    "clipboard.readImage",
    "clipboard.write"
  ],
  "window": {
    "width": 900,
    "height": 600,
    "minWidth": 420,
    "minHeight": 320
  },
  "features": [
    {
      "code": "main",
      "explain": "图片压缩与转换",
      "cmds": [
        "图片",
        "压缩",
        "image",
        "tp",
        {
          "type": "img",
          "label": "压缩这张图片"
        }
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "图片",
      "压缩",
      "格式转换",
      "水印",
      "EXIF"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "contributes": {
    "openWith": [
      {
        "id": "image-files",
        "extensions": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "gif"
        ],
        "mimeTypes": [
          "image/png",
          "image/jpeg",
          "image/webp",
          "image/gif"
        ],
        "role": "Viewer"
      }
    ],
    "settings": [
      {
        "id": "image-tools.preferences",
        "title": "图片工具箱",
        "items": [
          {
            "key": "followShellTheme",
            "type": "boolean",
            "label": "跟随壳子主题",
            "default": true,
            "shareWithThemes": true
          },
          {
            "key": "targetKb",
            "type": "slider",
            "label": "Quick 快速压缩目标体积（KB）",
            "default": 200,
            "min": 20,
            "max": 2048,
            "step": 20,
            "shareWithThemes": true
          },
          {
            "key": "quickFormat",
            "type": "select",
            "label": "Quick 快速压缩格式",
            "default": "image/jpeg",
            "options": [
              {
                "label": "JPEG",
                "value": "image/jpeg"
              },
              {
                "label": "WebP",
                "value": "image/webp"
              }
            ],
            "shareWithThemes": true
          },
          {
            "key": "autoPin",
            "type": "boolean",
            "label": "压缩完成后自动贴图预览",
            "default": false
          }
        ]
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5187/"
  }
}
