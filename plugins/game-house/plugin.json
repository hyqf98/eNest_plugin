{
  "id": "com.github.eNest.game-house",
  "name": "游戏屋",
  "version": "0.0.1",
  "description": "游戏库与下载器：多数据源浏览 PC 游戏、主机游戏与软件，天翼云盘扫码或账号登录后多线程下载，自动解压安装、启动与卸载，另含修改器、MOD 与网盘搜索。",
  "author": "eNest Labs",
  "main": "index.html",
  "views": {
    "layouts": ["shell"],
    "default": "shell"
  },
  "category": "其它",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "backend.node"
  ],
  "window": {
    "width": 1200,
    "height": 760,
    "minWidth": 480,
    "minHeight": 320
  },
  "features": [
    {
      "code": "main",
      "explain": "游戏屋：浏览、下载并安装游戏，管理我的游戏",
      "cmds": [
        "游戏",
        "游戏屋",
        "game-house",
        "gamehouse",
        "下载游戏",
        "yx",
        "yxw"
      ]
    },
    {
      "code": "settings",
      "explain": "游戏屋设置：网盘账号、下载目录与下载参数",
      "cmds": [
        "游戏屋设置",
        "game settings"
      ]
    }
  ],
  "contributes": {
    "settings": [
      {
        "id": "game-house.preferences",
        "title": "游戏屋",
        "items": [
          {
            "key": "followShellTheme",
            "type": "switch",
            "label": "跟随系统/壳子主题",
            "default": true
          },
          {
            "key": "openPreferences",
            "type": "page",
            "label": "打开游戏屋设置",
            "entry": {
              "code": "settings"
            }
          }
        ]
      }
    ]
  },
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": ["游戏", "下载器", "天翼云盘", "游戏库", "修改器", "MOD"],
    "readme": "assets/market/README.md",
    "screenshots": ["assets/market/screenshots/01-browse-light.png", "assets/market/screenshots/02-detail-dark.png"]
  },
  "development": {
    "main": "http://127.0.0.1:5224/"
  },
  "backend": {
    "entry": "backend/index.cjs"
  }
}
