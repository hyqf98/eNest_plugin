{
  "name": "com.enest.middleware",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node ../../scripts/build-plugin.mjs com.enest.middleware",
    "pack": "node ../../scripts/pack-plugin.mjs com.enest.middleware",
    "typecheck:backend": "tsc -p backend/tsconfig.json",
    "test:backend": "node --test backend/*.test.mjs"
  },
  "dependencies": {
    "@enest/plugin-kit": "1.0.0",
    "amqplib": "^2.2.0",
    "kafkajs": "^2.2.4",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3",
    "esbuild": "^0.21.5"
  },
  "enestBackend": {
    "entry": "backend/index.ts",
    "dependencies": [
      "amqplib",
      "kafkajs",
      "mqtt"
    ]
  }
}
