{
  "id": "com.github.eNest.anything",
  "name": "Anything 文件搜索",
  "version": "0.0.1",
  "description": "全盘文件即时搜索：Spotlight / Everything 引擎，关键词高亮、排序分页、文本与图片预览，打开、定位、移入废纸篓。",
  "author": "eNest Labs",
  "main": "index.html",
  "views": {
    "default": "shell",
    "layouts": ["quick", "shell", "panel"],
    "panel": { "size": { "width": 360, "height": 320 } }
  },
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.2.3"
  },
  "permissions": [
    "backend.node",
    "contribute",
    "clipboard.write",
    "shell.openExternal"
  ],
  "window": {
    "width": 860,
    "height": 560,
    "minWidth": 480,
    "minHeight": 360
  },
  "features": [
    {
      "code": "find-selection",
      "explain": "全局文件搜索与预览",
      "cmds": [
        "anything",
        "文件搜索",
        "本地搜索",
        "find"
      ]
    },
    {
      "code": "find",
      "explain": "用当前文本直接搜索文件",
      "cmds": [
        {
          "type": "over",
          "label": "文件搜索",
          "minLength": 1,
          "maxLength": 120,
          "exclude": "/[\\t\\n]/"
        }
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "transparent",
    "preferredColorScheme": "auto"
  },
  "contributes": {
    "settings": [
      {
        "id": "anything.preferences",
        "title": "Anything 文件搜索",
        "items": [
          {
            "key": "resultLimit",
            "type": "number",
            "label": "单次结果上限（条）",
            "default": 100,
            "min": 20,
            "max": 500,
            "shareWithThemes": true
          },
          {
            "key": "everythingPort",
            "type": "number",
            "label": "Everything HTTP 端口（Windows，0 为不启用）",
            "default": 0,
            "min": 0,
            "max": 65535
          },
          {
            "key": "everythingAuth",
            "type": "text",
            "label": "Everything HTTP 认证（用户名:密码，可空）",
            "default": ""
          }
        ]
      }
    ]
  },
  "market": {
    "tags": [
      "文件搜索",
      "Spotlight",
      "Everything",
      "效率"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5173/"
  },
  "backend": {
    "entry": "backend/index.cjs"
  }
}
