{
  "id": "com.github.eNest.password-kit",
  "name": "密码工具箱",
  "version": "1.3.0",
  "description": "随机密码、密码短语与 PIN 生成，强度检查（熵 + 破解时间估算），UUID v4 批量与本地生成历史。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "permissions": [
    "clipboard.write"
  ],
  "engines": {
    "enest": ">=0.1.0"
  },
  "features": [
    {
      "code": "main",
      "explain": "随机密码",
      "cmds": [
        "密码",
        "password"
      ]
    },
    {
      "code": "uuid",
      "explain": "UUID v4 生成",
      "cmds": [
        "uuid"
      ]
    },
    {
      "code": "inspect",
      "explain": "密码强度检查",
      "cmds": [
        "强度",
        "strength"
      ]
    }
  ],
  "market": {
    "tags": [
      "密码",
      "uuid",
      "安全"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "window": {
    "width": 760,
    "height": 520,
    "minWidth": 420,
    "minHeight": 280
  },
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "contributes": {
    "settings": [
      {
        "id": "password-kit.preferences",
        "title": "密码工具箱",
        "items": [
          {
            "key": "defaultLength",
            "type": "number",
            "label": "默认密码长度",
            "default": 16
          },
          {
            "key": "avoidAmbiguous",
            "type": "switch",
            "label": "排除易混淆字符",
            "default": false
          },
          {
            "key": "maskResults",
            "type": "switch",
            "label": "默认遮罩密码",
            "default": true
          },
          {
            "key": "uuidUppercase",
            "type": "switch",
            "label": "UUID 大写字母",
            "default": false
          },
          {
            "key": "uuidHyphens",
            "type": "switch",
            "label": "UUID 保留连字符",
            "default": true
          },
          {
            "key": "keepHistory",
            "type": "switch",
            "label": "保留生成历史（仅本地存储）",
            "default": true
          }
        ]
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5193/"
  }
}
