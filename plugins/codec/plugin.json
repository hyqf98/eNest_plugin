{
  "id": "com.github.eNest.codec",
  "name": "编解码",
  "version": "0.0.1",
  "description": "Base64、URL、Hex、Unicode、HTML 编解码与 JWT、URL 参数、Data URL 查看；逐行批量、错误定位、文件转 Data URL、最近转换记录。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "clipboard.read",
    "clipboard.write"
  ],
  "features": [
    {
      "code": "main",
      "title": "编解码",
      "explain": "Base64/URL/Hex/Unicode 等多格式互转",
      "cmds": [
        "编解码",
        "codec",
        "bjm",
        "bianjiema"
      ]
    },
    {
      "code": "base64",
      "title": "Base64 编解码",
      "explain": "Base64 编解码",
      "cmds": ["base64", "Base64编解码", "b64"]
    },
    {
      "code": "base64url",
      "title": "Base64URL 编解码",
      "explain": "Base64URL 编解码",
      "cmds": ["base64url", "Base64URL编解码"]
    },
    {
      "code": "url",
      "title": "URL 编解码",
      "explain": "URL 百分号编解码",
      "cmds": ["URL编码", "URL解码", "百分号编码", "url encode", "url decode"]
    },
    {
      "code": "hex",
      "title": "十六进制编解码",
      "explain": "Hex 十六进制编解码",
      "cmds": ["hex", "十六进制编解码", "十六进制"]
    },
    {
      "code": "unicode",
      "title": "Unicode 转义",
      "explain": "Unicode 转义编解码",
      "cmds": ["unicode", "Unicode转义"]
    },
    {
      "code": "html",
      "title": "HTML 实体编解码",
      "explain": "HTML 实体编解码",
      "cmds": ["HTML实体", "HTML转义", "html entities"]
    },
    {
      "code": "dataurl",
      "title": "Data URL 编解码",
      "explain": "Data URL 编解码与文件查看",
      "cmds": ["dataurl", "Data URL"]
    },
    {
      "code": "jwt",
      "title": "JWT 解码",
      "explain": "离线查看 JWT",
      "cmds": [
        "jwt",
        "jwt解码",
        "jwt decode"
      ]
    },
    {
      "code": "query",
      "title": "URL 参数解析",
      "explain": "URL 参数解析",
      "cmds": [
        "url参数",
        "urlcs",
        "query string"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "base64",
      "url",
      "hex",
      "开发"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "window": {
    "width": 760,
    "height": 480,
    "minWidth": 420,
    "minHeight": 280
  },
  "development": {
    "main": "http://127.0.0.1:5179/"
  }
}
