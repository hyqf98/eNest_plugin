{
  "id": "com.github.eNest.codec",
  "name": "编解码",
  "version": "0.0.1",
  "description": "Base64、URL、Hex、Unicode、HTML 编解码与 JWT、URL 参数、Data URL 查看；逐行批量、错误定位、文件转 Data URL、最近转换记录。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "clipboard.read",
    "clipboard.write",
    "shell.openExternal"
  ],
  "features": [
    {
      "code": "main",
      "explain": "编解码",
      "cmds": [
        "编解码",
        "codec"
      ]
    },
    {
      "code": "base64",
      "explain": "Base64 编解码",
      "cmds": ["base64", "Base64编解码"]
    },
    {
      "code": "base64url",
      "explain": "Base64URL 编解码",
      "cmds": ["base64url", "Base64URL编解码"]
    },
    {
      "code": "url",
      "explain": "URL 百分号编解码",
      "cmds": ["URL编码", "URL解码", "百分号编码"]
    },
    {
      "code": "hex",
      "explain": "Hex 十六进制编解码",
      "cmds": ["hex", "十六进制编解码"]
    },
    {
      "code": "unicode",
      "explain": "Unicode 转义编解码",
      "cmds": ["unicode", "Unicode转义"]
    },
    {
      "code": "html",
      "explain": "HTML 实体编解码",
      "cmds": ["HTML实体", "HTML转义"]
    },
    {
      "code": "dataurl",
      "explain": "Data URL 编解码与文件查看",
      "cmds": ["dataurl", "Data URL"]
    },
    {
      "code": "jwt",
      "explain": "离线查看 JWT",
      "cmds": [
        "jwt"
      ]
    },
    {
      "code": "query",
      "explain": "URL 参数解析",
      "cmds": [
        "url参数"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "base64",
      "url",
      "hex",
      "开发"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "window": {
    "width": 760,
    "height": 480,
    "minWidth": 420,
    "minHeight": 280
  },
  "contributes": {
    "settings": [
      {
        "id": "codec.preferences",
        "title": "编解码",
        "items": [
          {
            "key": "defaultMode",
            "type": "select",
            "label": "默认工具",
            "default": "base64",
            "options": [
              {
                "label": "base64",
                "value": "base64"
              },
              {
                "label": "base64url",
                "value": "base64url"
              },
              {
                "label": "url",
                "value": "url"
              },
              {
                "label": "hex",
                "value": "hex"
              },
              {
                "label": "unicode",
                "value": "unicode"
              },
              {
                "label": "html",
                "value": "html"
              },
              {
                "label": "jwt",
                "value": "jwt"
              },
              {
                "label": "query",
                "value": "query"
              },
              {
                "label": "dataurl",
                "value": "dataurl"
              }
            ],
            "shareWithThemes": true
          },
          {
            "key": "liveConversion",
            "type": "switch",
            "label": "输入后自动转换",
            "default": true,
            "shareWithThemes": true
          },
          {
            "key": "strictUtf8",
            "type": "switch",
            "label": "严格校验 UTF-8",
            "default": true,
            "shareWithThemes": true
          }
        ]
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5179/"
  }
}
