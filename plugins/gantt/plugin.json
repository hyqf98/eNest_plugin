{
  "id": "com.github.eNest.gantt",
  "name": "甘特图",
  "version": "0.0.1",
  "description": "项目计划甘特图：多计划管理、时间范围拖拽调整、进度、依赖连线、子任务与里程碑；支持导出 Excel 与 HTML。",
  "author": "eNest Labs",
  "main": "index.html",
  "views": {
    "layouts": ["shell"],
    "default": "shell"
  },
  "window": { "width": 1200, "height": 780, "minWidth": 900, "minHeight": 560 },
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [],
  "features": [
    {
      "code": "main",
      "explain": "打开甘特图",
      "cmds": [
        "gantt",
        "甘特图",
        "甘特",
        "排期",
        "计划图",
        "gantetu"
      ]
    }
  ],
  "contributes": {
    "homeCards": [
      {
        "id": "gantt-card",
        "title": "甘特图",
        "glyph": "▤",
        "color": "#0d9488",
        "explain": "计划排期、任务拖拽调整、导出",
        "openCode": "main"
      }
    ],
    "mcpTools": [
      {
        "id": "plans.list",
        "title": "List gantt plans",
        "description": "List all plans with per-plan task counts, completion percentage, date range and update time.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true
        }
      },
      {
        "id": "plan.create",
        "title": "Create gantt plan",
        "description": "Create a new plan by name (max 60 chars). Returns the created plan with a sample-free empty task list; optionally set it active.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 60 },
            "activate": { "type": "boolean", "description": "Set as active plan, default true." }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false
        }
      },
      {
        "id": "plan.update",
        "title": "Update gantt plan",
        "description": "Rename a plan by id, or set it as the active plan.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "name": { "type": "string", "minLength": 1, "maxLength": 60 },
            "activate": { "type": "boolean" }
          },
          "required": ["id"],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true
        }
      },
      {
        "id": "plan.delete",
        "title": "Delete gantt plan",
        "description": "Delete a plan by id together with all its tasks. Cannot delete the last remaining plan.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "required": ["id"],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true
        }
      },
      {
        "id": "tasks.list",
        "title": "List gantt tasks",
        "description": "List tasks of a plan (default the active plan) with hierarchy, dates, progress, color, milestone flag, dependencies and note. Supports keyword filter and milestone-only filter.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "planId": { "type": "string", "maxLength": 64, "description": "Plan id from plans.list; default active plan." },
            "keyword": { "type": "string", "maxLength": 200, "description": "Substring match on task name and note." },
            "milestone": { "type": "boolean" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "description": "Max tasks returned, default 200." }
          },
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true
        }
      },
      {
        "id": "task.create",
        "title": "Create gantt task",
        "description": "Create a task in a plan (default active). Fields: name, start/end dates (YYYY-MM-DD), progress 0-100, colorIndex 0-9, milestone, parentId for subtask, deps (ids of predecessor tasks, finish-to-start), note. end defaults to start; milestone tasks use a single date.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "planId": { "type": "string", "maxLength": 64 },
            "name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
            "colorIndex": { "type": "integer", "minimum": 0, "maximum": 9 },
            "milestone": { "type": "boolean" },
            "parentId": { "type": "string", "maxLength": 64 },
            "deps": {
              "type": "array",
              "items": { "type": "string", "maxLength": 64 },
              "maxItems": 16
            },
            "note": { "type": "string", "maxLength": 2000 }
          },
          "required": ["name", "start"],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false
        }
      },
      {
        "id": "task.update",
        "title": "Update gantt task",
        "description": "Update mutable fields of one task by id: name, start, end, progress, colorIndex, milestone, parentId (empty string clears), deps, note, collapsed. Only provided fields change.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "planId": { "type": "string", "maxLength": 64, "description": "Locate the task inside this plan; default active plan." },
            "id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
            "colorIndex": { "type": "integer", "minimum": 0, "maximum": 9 },
            "milestone": { "type": "boolean" },
            "parentId": { "type": "string", "maxLength": 64 },
            "deps": {
              "type": "array",
              "items": { "type": "string", "maxLength": 64 },
              "maxItems": 16
            },
            "note": { "type": "string", "maxLength": 2000 },
            "collapsed": { "type": "boolean" }
          },
          "required": ["id"],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true
        }
      },
      {
        "id": "task.delete",
        "title": "Delete gantt task",
        "description": "Delete one task by id; its subtasks are promoted to the deleted task's parent, and dependencies referencing it are removed.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "planId": { "type": "string", "maxLength": 64 },
            "id": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "required": ["id"],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true
        }
      },
      {
        "id": "plan.summary",
        "title": "Summarize gantt plan",
        "description": "Overview of a plan (default active): task/leaf counts, overall progress, date range, milestones, per-status counts (done/ongoing/todo/overdue), dependency violations and risks. Read-only.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "planId": { "type": "string", "maxLength": 64 }
          },
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true
        }
      }
    ]
  },
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "transparent",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "甘特图",
      "排期",
      "项目管理",
      "效率"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5222/"
  }
}
