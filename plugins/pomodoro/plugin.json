{
  "id": "com.github.eNest.pomodoro",
  "name": "番茄钟",
  "version": "0.0.1",
  "description": "主进程后台专注计时，长短休息、时长预设、完成提示音与本地统计。",
  "author": "eNest Labs",
  "main": "index.html",
  "views": {
    "layouts": ["quick", "shell", "panel"],
    "default": "shell",
    "panel": { "size": { "width": 240, "height": 240 } }
  },
  "category": "效率",
  "icon": "assets/market/icon.svg",
  "permissions": [
    "notify"
  ],
  "engines": {
    "enest": ">=0.0.1"
  },
  "features": [
    {
      "code": "main",
      "cmds": [
        "番茄钟",
        "pomodoro",
        "专注"
      ]
    }
  ],
  "market": {
    "tags": [
      "番茄钟",
      "专注",
      "效率"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "transparent",
    "preferredColorScheme": "auto"
  },
  "contributes": {
    "settings": [
      {
        "id": "pomodoro.preferences",
        "title": "番茄钟",
        "items": [
          {
            "key": "focusMin",
            "type": "number",
            "label": "默认专注分钟",
            "default": 25,
            "min": 1,
            "max": 180,
            "step": 1,
            "shareWithThemes": true
          },
          {
            "key": "breakMin",
            "type": "number",
            "label": "默认短休息分钟",
            "default": 5,
            "min": 1,
            "max": 60,
            "step": 1,
            "shareWithThemes": true
          },
          {
            "key": "longBreakMin",
            "type": "number",
            "label": "长休息分钟",
            "default": 15,
            "min": 1,
            "max": 120,
            "step": 1,
            "shareWithThemes": true
          },
          {
            "key": "longBreakEvery",
            "type": "number",
            "label": "每几轮长休息",
            "default": 4,
            "min": 2,
            "max": 12,
            "step": 1,
            "shareWithThemes": true
          },
          {
            "key": "preset",
            "type": "select",
            "label": "时长预设",
            "default": "25,5",
            "options": [
              {
                "label": "25 / 5 经典",
                "value": "25,5"
              },
              {
                "label": "50 / 10 深度",
                "value": "50,10"
              },
              {
                "label": "15 / 3 短冲刺",
                "value": "15,3"
              },
              {
                "label": "自定义",
                "value": ""
              }
            ],
            "shareWithThemes": true
          },
          {
            "key": "sound",
            "type": "switch",
            "label": "阶段完成播放提示音",
            "default": true,
            "shareWithThemes": true
          },
          {
            "key": "autoStart",
            "type": "switch",
            "label": "阶段结束自动开始下一阶段",
            "default": false
          },
          {
            "key": "notify",
            "type": "switch",
            "label": "阶段完成时发送系统通知",
            "default": true
          }
        ]
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5194/"
  }
}
