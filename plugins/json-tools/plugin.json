{
  "id": "com.github.eNest.json-tools",
  "name": "JSON 工具",
  "version": "0.0.1",
  "description": "无损数字 JSON 格式化、路径查询、TypeScript 类型生成、统计、树浏览与差异比较。",
  "author": "eNest Labs",
  "main": "index.html",
  "category": "开发",
  "icon": "assets/market/icon.svg",
  "engines": {
    "enest": ">=0.0.1"
  },
  "permissions": [
    "clipboard.read",
    "clipboard.write"
  ],
  "features": [
    {
      "code": "main",
      "explain": "JSON 格式化与检查",
      "cmds": [
        "json",
        "JSON",
        "格式化"
      ]
    }
  ],
  "ui": {
    "chrome": "none",
    "themeAware": true,
    "background": "opaque",
    "preferredColorScheme": "auto"
  },
  "market": {
    "tags": [
      "json",
      "开发",
      "格式化"
    ],
    "readme": "assets/market/README.md",
    "screenshots": [
      "assets/market/screenshots/01-main.png"
    ]
  },
  "window": {
    "width": 760,
    "height": 480,
    "minWidth": 420,
    "minHeight": 280
  },
  "contributes": {
    "openWith": [
      {
        "id": "json-files",
        "extensions": [
          "json",
          "jsonc"
        ],
        "mimeTypes": [
          "application/json"
        ],
        "role": "Editor"
      }
    ]
  },
  "development": {
    "main": "http://127.0.0.1:5188/"
  }
}
