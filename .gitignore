node_modules/
dist/
.DS_Store
test-results/
playwright-report/

test-results-*/
logs/
*.log
# 共享包物化产物：由 @enest/native-surfaces 与 @enest/lxgw-font 的 vite 插件在
# configResolved 阶段写入各插件 public/；唯一副本保存在 packages/*/assets/。
/plugins/*/public/assets/vendor/native-surfaces/
/plugins/*/public/assets/vendor/fonts/
# 壁纸插件按平台构建的原生 helper 与 SDK 缓存，不提交二进制
/plugins/*/helper-cache/
/plugins/*/native/**/.cache/
# 插件根下的临时验证产物（与宿主的 .cache/verification/ 同性质），不提交
/plugins/*/.cache/
/plugins/*/native/**/.build/
/plugins/*/native/**/build/
# 插件测试运行期生成的临时入口与打包产物（如 codex-pets 测试用 esbuild 打平源码），不提交
/plugins/*/tests/.*.tmp.*
/plugins/image-gen/tests/__live/
/plugins/image-gen/tests/__live-entry.js
/plugins/image-gen/tests/__preview-entry.js
/plugins/image-gen/tests/__shell.html
